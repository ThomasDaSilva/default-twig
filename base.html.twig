<!DOCTYPE html>
{# lang must be a valid BCP 47 tag: Thelia locales use underscores (en_US), browsers and Intl APIs require dashes (en-US) #}
{# "ltr" or "rtl", from the working language of the administrator. The Thelia template
   parser also publishes the value as a `lang_direction` variable, but a variable only
   exists where something puts it: the back-office controllers render through the Twig
   environment directly and never go through that parser, and neither does a live
   component re-rendering itself nor a macro. The function is registered on the global
   Twig environment by the TwigEngine module, so it answers on every one of those - and
   it answers "ltr" rather than fail, this being the base template of every
   administration screen. #}
<html lang="{{ app.request.locale|default('en')|replace({'_': '-'}) }}" dir="{{ lang_direction() }}" data-bs-theme="light">
    {% block head %}
        <head>
            <meta charset="UTF-8">
            <meta name="viewport" content="width=device-width, initial-scale=1">
            <meta name="referrer" content="same-origin">
            {# The token of the state-changing requests (POST links, drag-and-drop
               reordering): scripts send it in the request body, never in a URL. #}
            <meta name="bo-token" content="{{ assignToken() }}">

            <title>{% block title %}{{ 'Back-office'|trans }}{% endblock %} - Thelia</title>

            {% block stylesheets %}
                <link rel="stylesheet" href="{{ asset('backoffice/styles/main.scss') }}">
            {% endblock %}

            {# The importmap of the back-office pages, rendered by the theme's
               ImportMapExtension: it is local to these pages and never touches the
               application importmap.php, which belongs to the front-office theme. #}
            {% block importmap %}
                {{ bo_importmap() }}
            {% endblock %}

            {% block head_extra %}{% endblock %}

            {% block head_hook %}
                {{ safe_hook('main.head-css') }}
            {% endblock %}
        </head>
    {% endblock %}

    <body class="bg-body-secondary" data-testid="{% block body_testid %}bo-page{% endblock %}" data-controller="bootstrap-bridge bo-post-link">
        {% block body %}
            <div class="bo-layout">
                {% block side_nav %}{% include '@BackOfficeDefaultTwig/_side_nav.html.twig' %}{% endblock %}

                <div class="bo-main flex-grow-1 d-flex flex-column">
                    {% block top_nav %}{% include '@BackOfficeDefaultTwig/_top_nav.html.twig' %}{% endblock %}

                    <main class="p-3 p-md-4 flex-grow-1" data-testid="bo-main">
                        {% block breadcrumb %}{% endblock %}
                        {% block flash %}
                            {% for type, messages in bo_flashes() %}
                                {% for message in messages %}
                                    <div class="alert alert-{{ type }} alert-dismissible fade show" role="alert" data-testid="bo-flash-{{ type }}">
                                        {{ message }}
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                {% endfor %}
                            {% endfor %}
                        {% endblock %}

                        {{ safe_hook('main.before-content') }}
                        {% block content %}{% endblock %}
                        {{ safe_hook('main.after-content', { location: 'after_content' }) }}
                    </main>

                    {% block footer %}{% include '@BackOfficeDefaultTwig/_footer.html.twig' %}{% endblock %}
                </div>
            </div>
        {% endblock %}

        {% block scripts %}
            <script type="module" src="{{ asset('backoffice/app.js') }}"></script>
        {% endblock %}

        {% block scripts_extra %}{% endblock %}
        {{ safe_hook('main.footer-js') }}
    </body>
</html>
