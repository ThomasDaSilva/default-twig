{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit brand'|trans }} - {{ brand.title }}{% endblock %}
{% block body_testid %}catalog-brand-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.brand.default') }}">{{ 'Brands'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ brand.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('brand-edit.top', { brand_id: brand.id }) }}

    {% set extra_tabs = hook_block('brand.tab', { brand: brand.id, id: brand.id }) %}
    {# A module tab opens like a native one when current_tab names it; an unknown tab falls back to the general one. #}
    {% set current_tab = current_tab in ['general', 'images', 'documents', 'seo', 'modules']|merge(extra_tabs|map(block => block.id)) ? current_tab : 'general' %}

    <div class="container-fluid" data-testid="brand-edit-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Brand'|trans }} <small class="text-muted">#{{ brand.id }}</small></h1>
            <div class="d-flex flex-wrap gap-2">
                {% include '@BackOfficeDefaultTwig/_prev_next_buttons.html.twig' with {
                    prev_url: prev_url|default(null),
                    next_url: next_url|default(null),
                    prev_label: 'Edit previous brand'|trans,
                    next_label: 'Edit next brand'|trans,
                    testid: 'brand',
                } only %}
                {% if preview_url is defined and preview_url %}
                    <a href="{{ preview_url }}" target="_blank" rel="noopener" class="btn btn-outline-secondary flex-shrink-0" title="{{ 'Preview brand page'|trans }}" data-testid="brand-preview-btn">
                        <i class="bi bi-eye" aria-hidden="true"></i> {{ 'Preview'|trans }}
                    </a>
                {% endif %}
                <a href="{{ path('admin.brand.default') }}" class="btn btn-outline-secondary" data-testid="brand-edit-back">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to list'|trans }}
                </a>
            </div>
        </div>

        <div class="bo-tab-bar">
            <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'general' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" role="tab" data-testid="brand-tab-general">
                    {{ 'General'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'images' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-images" type="button" role="tab" data-testid="brand-tab-images">
                    {{ 'Images'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'documents' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-documents" type="button" role="tab" data-testid="brand-tab-documents">
                    {{ 'Documents'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'seo' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-seo" type="button" role="tab" data-testid="brand-tab-seo">
                    {{ 'SEO'|trans }}
                </button>
            </li>
            {% for block in extra_tabs %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link {% if current_tab == block.id %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                            {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                            type="button" data-testid="brand-tab-{{ block.id }}">{{ block.title }}</button>
                </li>
            {% endfor %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab == 'modules' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" role="tab" data-testid="brand-tab-modules">
                    {{ 'Modules'|trans }}
                </button>
            </li>
        </ul>
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade {% if current_tab == 'general' %}show active{% endif %}" id="tab-general" role="tabpanel">
                {% form_theme form with bo_form_themes only %}
                {{ form_start(form, { action: path('admin.brand.save', { brand_id: brand.id }), method: 'post', attr: { 'data-testid': 'brand-edit-form' } }) }}
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-3">
                                {{ form_label(form.title) }}
                                {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                                {{ form_errors(form.title) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.chapo) }}
                                {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 8 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.postscriptum) }}
                                {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                        </div>
                        <div class="col-md-4">
                            {{ safe_hook('brand.modification.form-right.top', { brand_id: brand.id }) }}
                            <div class="form-check mb-3">
                                {{ form_widget(form.visible, { attr: { class: 'form-check-input' } }) }}
                                {{ form_label(form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                            </div>

                            <div class="mb-3" data-controller="bo-brand-logo-picker" data-testid="brand-logo-picker">
                                <label class="form-label">{{ 'Select the brand logo'|trans }}</label>
                                {{ form_widget(form.logo_image_id, { attr: { 'data-bo-brand-logo-picker-target': 'input' } }) }}

                                {% if logo_images|length == 0 %}
                                    <div class="alert alert-info small mb-0" data-testid="brand-logo-picker-empty">
                                        {{ 'Upload images in the Images tab before choosing a logo.'|trans }}
                                        <a href="{{ images_tab_url }}" class="alert-link">{{ 'Go to Images tab'|trans }}</a>
                                    </div>
                                {% else %}
                                    {% set selected_image = null %}
                                    {% for image in logo_images %}
                                        {% if image.id == logo_image_id %}
                                            {% set selected_image = image %}
                                        {% endif %}
                                    {% endfor %}
                                    <div class="text-center bg-light rounded p-3 mb-2" data-bo-brand-logo-picker-target="previewWrapper">
                                        <img src="{{ selected_image ? selected_image.preview_url : '' }}"
                                             alt="{{ selected_image ? selected_image.title : '' }}"
                                             class="img-fluid {% if not selected_image %}d-none{% endif %}"
                                             style="max-height: 200px;"
                                             data-bo-brand-logo-picker-target="preview"
                                             data-testid="brand-logo-preview">
                                        <div class="text-muted small py-4 {% if selected_image %}d-none{% endif %}"
                                             data-bo-brand-logo-picker-target="emptyPreview"
                                             data-testid="brand-logo-preview-empty">
                                            {{ 'No logo selected'|trans }}
                                        </div>
                                    </div>

                                    <div class="d-flex flex-wrap gap-2" role="radiogroup" aria-label="{{ 'Brand logo candidates'|trans }}">
                                        <button type="button"
                                                class="btn btn-sm border rounded p-1 d-flex align-items-center justify-content-center {% if logo_image_id == 0 %}border-primary border-2{% endif %}"
                                                style="width: 80px; height: 80px;"
                                                data-action="bo-brand-logo-picker#select"
                                                data-bo-brand-logo-picker-image-id-param="0"
                                                data-bo-brand-logo-picker-preview-url-param=""
                                                data-testid="brand-logo-pick-none"
                                                title="{{ 'No logo image'|trans }}"
                                                aria-pressed="{{ logo_image_id == 0 ? 'true' : 'false' }}">
                                            <i class="bi bi-slash-circle text-muted fs-3"></i>
                                        </button>
                                        {% for image in logo_images %}
                                            <button type="button"
                                                    class="btn btn-sm border rounded p-1 d-flex align-items-center justify-content-center {% if image.id == logo_image_id %}border-primary border-2{% endif %}"
                                                    style="width: 80px; height: 80px;"
                                                    data-action="bo-brand-logo-picker#select"
                                                    data-bo-brand-logo-picker-image-id-param="{{ image.id }}"
                                                    data-bo-brand-logo-picker-preview-url-param="{{ image.preview_url }}"
                                                    data-testid="brand-logo-pick-{{ image.id }}"
                                                    title="{{ image.title }}"
                                                    aria-pressed="{{ image.id == logo_image_id ? 'true' : 'false' }}">
                                                <img src="{{ image.thumbnail_url }}"
                                                     alt="{{ image.title }}"
                                                     class="img-fluid"
                                                     style="max-width: 100%; max-height: 100%; object-fit: contain;">
                                            </button>
                                        {% endfor %}
                                    </div>
                                {% endif %}
                            </div>
                            {{ safe_hook('brand.modification.form-right.bottom', { brand_id: brand.id }) }}
                        </div>
                    </div>
                    {{ form_widget(form.id) }}
                    {{ form_widget(form.locale) }}
                    {{ safe_hook('brand.update-form', { brand: brand.id }) }}
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary" data-testid="brand-edit-submit">
                            <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                        </button>
                    </div>
                {{ form_widget(form._token) }}
                {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                {{ form_end(form, {render_rest: false}) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'images' %}show active{% endif %}" id="tab-images" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::imageForm', { parentType: 'brand', parentId: brand.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'documents' %}show active{% endif %}" id="tab-documents" role="tabpanel">
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\File\\FileController::documentForm', { parentType: 'brand', parentId: brand.id })) }}
            </div>

            <div class="tab-pane fade {% if current_tab == 'seo' %}show active{% endif %}" id="tab-seo" role="tabpanel">
                {{ safe_hook('tab-seo.top', { id: brand.id, type: 'brand' }) }}
                {% form_theme seo_form with bo_form_themes only %}
                {{ form_start(seo_form, { action: path('admin.brand.seo.save'), method: 'post', attr: { 'data-testid': 'brand-seo-form' } }) }}
                    <div class="mb-3">
                        {{ form_label(seo_form.url) }}
                        {{ form_widget(seo_form.url, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_title) }}
                        {{ form_widget(seo_form.meta_title, { attr: { class: 'form-control' } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_description) }}
                        {{ form_widget(seo_form.meta_description, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(seo_form.meta_keywords) }}
                        {{ form_widget(seo_form.meta_keywords, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    {{ form_widget(seo_form.id) }}
                    {{ form_widget(seo_form.locale) }}
                    <button type="submit" class="btn btn-primary" data-testid="brand-seo-submit">
                        <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save SEO'|trans }}
                    </button>
                {{ form_widget(seo_form._token) }}
                {# module fields added through the legacy form bridge are rendered by the module hooks, not auto-dumped #}
                {{ form_end(seo_form, {render_rest: false}) }}
                {{ hook_cards(['brand.seo.update-form', 'tab-seo.update-form', 'tab-seo.bottom'], { brand: brand.id, id: brand.id, type: 'brand' }) }}
            </div>

            {% for block in extra_tabs %}
                <div class="tab-pane fade {% if current_tab == block.id %}show active{% endif %}" id="{{ block.id }}" role="tabpanel">
                    {% if block.href is defined and block.href %}
                        <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                    {% else %}
                        {{ block.content|raw }}
                    {% endif %}
                </div>
            {% endfor %}

            <div class="tab-pane fade {% if current_tab == 'modules' %}show active{% endif %}" id="tab-modules" role="tabpanel">
                {{ hook_cards('brand.tab-content', { brand: brand.id, location: 'brand-edit', view: 'brand' }) }}
            </div>
        </div>
    </div>

    {{ safe_hook('brand-edit.bottom', { brand_id: brand.id }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('brand.edit-js', { brand_id: brand.id, location: 'brand-edit-js' }) }}
    {{ safe_hook('wysiwyg.js', { location: 'wysiwyg-brand-edit-js' }) }}
{% endblock %}
