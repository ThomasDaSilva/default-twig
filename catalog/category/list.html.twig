{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Categories'|trans }}{% endblock %}
{% block body_testid %}catalog-categories{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.categories.default') }}">{{ 'Catalog'|trans }}</a></li>
            {% for crumb in breadcrumb_path %}
                {% if loop.last %}
                    <li class="breadcrumb-item active" aria-current="page">{{ crumb.title }}</li>
                {% else %}
                    <li class="breadcrumb-item"><a href="{{ path('admin.categories.default', { category_id: crumb.id }) }}">{{ crumb.title }}</a></li>
                {% endif %}
            {% endfor %}
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('categories.top', { location: 'categories_top' }) }}

    <div class="container-fluid" data-testid="categories-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Categories'|trans } %}
            {% block actions %}
                <a href="{{ path('admin.categories.tree') }}" class="btn btn-outline-secondary btn-sm" data-testid="category-tree-link">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i> {{ 'Tree view'|trans }}
                </a>
                {% if parent_id > 0 %}
                    <a href="{{ path('admin.categories.update', { category_id: parent_id }) }}" class="btn btn-outline-secondary btn-sm" data-testid="category-edit-parent">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i> {{ 'Edit this category'|trans }}
                    </a>
                {% endif %}
                {% if is_granted('CREATE', 'admin.category') %}
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#category-create-modal" data-testid="category-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        {{ 'Add a new category'|trans }}
                    </button>
                {% endif %}
            {% endblock %}
        {% endembed %}

        {{ safe_hook('categories.caption', { location: 'category_list_caption' }) }}

        {{ component('BoDataTable', {
            id: 'categories',
            columns: [
                column('id', 'ID'|trans, hideBelow: 'md'),
                column_html('thumbnail_html', 'Image'|trans, 'center', hideBelow: 'md'),
                column_html('title_html', 'Title'|trans),
                column_toggle('visible', 'Online'|trans, 'toggle_visible_url'),
                column_position('position', 'Position'|trans, 'center', hideBelow: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No subcategory yet.'|trans,
            extraColumnsHeaderHook: 'categories.header',
            extraColumnsHook: 'categories.row',
            headerHookContext: { location: 'category_list_header' },
            rowHookContext: { location: 'category_list_row' },
            rowHookArgs: { category_id: 'id' },
            tbodyAttributes: {
                'data-controller': 'bo-sortable bo-position',
                'data-bo-sortable-url-value': update_position_url,
                'data-bo-sortable-token-value': update_position_token,
                'data-bo-sortable-param-name-value': 'category_id',
                'data-bo-position-url-value': update_position_url,
                'data-bo-position-token-value': update_position_token,
                'data-bo-position-param-name-value': 'category_id',
                'data-bo-position-title-value': 'Position'|trans,
                'data-bo-position-save-label-value': 'Save'|trans,
                'data-bo-position-cancel-label-value': 'Cancel'|trans,
            },
        }) }}

        {% if parent_id > 0 %}
            <section class="mt-4" data-testid="category-products-section">
                <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
                    <h2 class="h5 mb-0">{{ 'Products in this category'|trans }} <span class="badge bg-secondary">{{ product_total }}</span></h2>
                    {% if is_granted('CREATE', 'admin.product') %}
                        <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#product-create-modal" data-testid="category-product-create-button">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new product'|trans }}
                        </button>
                    {% endif %}
                </div>

                {{ safe_hook('products.caption', { location: 'product_list_caption' }) }}

                {{ component('BoDataTable', {
                    id: 'category-products',
                    columns: [
                        column('id', 'ID'|trans, hideBelow: 'md'),
                        column_html('thumbnail_html', 'Image'|trans, 'center', hideBelow: 'md'),
                        column('ref', 'Reference'|trans),
                        column_html('title_html', 'Title'|trans),
                        column_toggle('visible', 'Online'|trans, 'toggle_visible_url'),
                        column_position('position', 'Position'|trans, 'center', hideBelow: 'lg'),
                        column_actions('_actions', 'Actions'|trans),
                    ],
                    rows: product_rows,
                    emptyMessage: 'No product in this category yet.'|trans,
                    extraColumnsHeaderHook: 'products.header',
                    extraColumnsHook: 'products.row',
                    headerHookContext: { location: 'product_list_header' },
                    rowHookContext: { location: 'product_list_row' },
                    rowHookArgs: { product_id: 'id' },
                    tbodyAttributes: {
                        'data-controller': 'bo-sortable bo-position',
                        'data-bo-sortable-url-value': product_update_position_url,
                        'data-bo-sortable-token-value': product_update_position_token,
                        'data-bo-sortable-param-name-value': 'product_id',
                        'data-bo-position-url-value': product_update_position_url,
                        'data-bo-position-token-value': product_update_position_token,
                        'data-bo-position-param-name-value': 'product_id',
                        'data-bo-position-title-value': 'Position'|trans,
                        'data-bo-position-save-label-value': 'Save'|trans,
                        'data-bo-position-cancel-label-value': 'Cancel'|trans,
                    },
                }) }}

                {{ component('BoPagination', {
                    route: 'admin.categories.default',
                    currentPage: product_current_page,
                    lastPage: product_pages,
                    routeParams: { category_id: parent_id },
                    ariaLabel: 'Category products pagination',
                    testid: 'category-products-pagination',
                }) }}
            </section>

            {% if is_granted('CREATE', 'admin.product') %}
                {{ render(controller('BackOfficeDefaultTwigBundle\\Controller\\Catalog\\ProductController::createModalFragment', { default_category: parent_id })) }}
            {% endif %}
        {% endif %}
    </div>

    {{ safe_hook('categories.bottom', { location: 'categories_bottom' }) }}

    {{ safe_hook('categories.catalog-bottom', { location: 'catalog_bottom' }) }}

    <div class="modal fade" id="category-create-modal" tabindex="-1" aria-labelledby="category-create-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                {% form_theme create_form with bo_form_themes only %}
                {{ form_start(create_form, { action: path('admin.categories.create'), method: 'post', attr: { 'data-testid': 'category-create-form' } }) }}
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="category-create-modal-title">{{ 'Create a new category'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            {{ form_label(create_form.title) }}
                            {{ form_widget(create_form.title, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(create_form.title) }}
                        </div>
                        <div class="form-check mb-3">
                            {{ form_widget(create_form.visible, { attr: { class: 'form-check-input' } }) }}
                            {{ form_label(create_form.visible, null, { label_attr: { class: 'form-check-label' } }) }}
                        </div>
                        {{ form_widget(create_form.locale) }}
                        {{ form_widget(create_form.parent) }}
                        {{ safe_hook('category.create-form', { location: 'category_create_form' }) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="category-create-submit">{{ 'Create'|trans }}</button>
                    </div>
                {{ form_end(create_form) }}
            </div>
        </div>
    </div>

    {{ component('BoConfirmDialog', {
        id: 'category-delete-modal',
        title: 'Delete category',
        formAction: path('admin.categories.delete', category_action_params),
        message: 'Do you really want to delete this category? Its subcategories and the products it owns will also be deleted.',
        testid: 'category-delete',
        hook: 'category.delete-form',
        hookContext: { location: 'category_delete_form' },
        prefillTrigger: 'data-category-id',
        prefillInput: 'category_id',
    }) }}

    {% if parent_id > 0 %}
        {{ component('BoConfirmDialog', {
            id: 'category-product-delete-modal',
            title: 'Delete product',
            formAction: path('admin.products.delete', product_action_params),
            message: 'Do you really want to delete this product?',
            testid: 'category-product-delete',
            hook: 'product.delete-form',
            hookContext: { location: 'product_delete_form' },
            prefillTrigger: 'data-product-id',
            prefillInput: 'product_id',
        }) }}
    {% endif %}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('categories.js', { location: 'categories-js' }) }}
{% endblock %}
