<div data-testid="product-combinations-tab">
    {{ safe_hook('product.combinations-tab.top', { product: product.id }) }}

    <div class="card mb-3 bo-combinations-card" data-testid="product-combinations-section"
         {%- if has_combinations %}
         data-controller="bo-bulk-select bo-combinations-bulk-edit"
         data-bo-combinations-bulk-edit-active-class="bo-combinations-card--bulk"
         data-bo-combinations-bulk-edit-folded-class="bo-side-panel--folded"
         data-bo-combinations-bulk-edit-bo-pse-price-with-tax-outlet="form[data-testid='combinations-form']"
         {%- endif %}>
        <div class="card-header d-flex justify-content-between align-items-end gap-2 flex-wrap">
            {% if available_currencies|default([])|length > 1 %}
                <div data-testid="combinations-currency-wrapper">
                    <label class="form-label mb-1" for="combinations-currency-switcher">{{ 'Prices in currency'|trans }}</label>
                    <select class="form-select form-select-sm" style="width:auto" id="combinations-currency-switcher"
                            data-testid="combinations-currency-switcher"
                            onchange="window.location.assign(this.value)">
                        {% for option in available_currencies %}
                            <option value="{{ path('admin.products.update', { product_id: product.id, current_tab: 'pse', combinations_currency_id: option.id, sale_unit_id: sale_unit_values.sale_unit.id|default(null) }) }}"{% if option.id == currency.id %} selected{% endif %}>{{ option.code }} ({{ option.symbol }})</option>
                        {% endfor %}
                    </select>
                </div>
            {% else %}
                <span></span>
            {% endif %}

            {% if has_combinations or template_attributes is not empty %}
                <div class="d-flex flex-wrap gap-2" data-testid="combinations-toolbar">
                    {% if has_combinations %}
                        <button type="button" class="btn btn-outline-secondary" aria-controls="combinations-bulk-panel" aria-expanded="false"
                                data-bo-combinations-bulk-edit-target="toggle" data-action="bo-combinations-bulk-edit#toggle"
                                data-testid="combinations-bulk-toggle">
                            <span class="bo-combinations-bulk-toggle__enter"><i class="bi bi-ui-checks" aria-hidden="true"></i> {{ 'Bulk edit'|trans }}</span>
                            <span class="bo-combinations-bulk-toggle__exit"><i class="bi bi-x-lg" aria-hidden="true"></i> {{ 'Exit bulk edit'|trans }}</span>
                        </button>
                    {% endif %}
                    {% if template_attributes is not empty %}
                        <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#combination-creation-modal" data-testid="combination-create-btn">
                            <i class="bi bi-plus-circle" aria-hidden="true"></i> {{ 'Add a combination'|trans }}
                        </button>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#combination-builder-modal" data-testid="combination-builder-btn">
                            <i class="bi bi-stars" aria-hidden="true"></i> {{ 'Combination builder'|trans }}
                        </button>
                    {% endif %}
                </div>
            {% endif %}
        </div>

        <div class="card-body">
            {% if has_combinations %}
                <form method="post" action="{{ path('admin.product.combination.update') }}" data-testid="combinations-form"
                      data-bo-unsaved-changes-target="form"
                      data-controller="bo-pse-price-with-tax bo-combination-default"
                      data-bo-pse-price-with-tax-calc-url-value="{{ path('admin.product.calculate-price') }}"
                      data-bo-pse-price-with-tax-product-id-value="{{ product.id }}">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <input type="hidden" name="product_id" value="{{ product.id }}">
                    <input type="hidden" name="currency" value="{{ currency.id }}">
                    <input type="hidden" name="visible_sent" value="1">

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label required" for="combinations-tax-rule">
                                <span class="bo-form-label__text">{{ 'Tax rule'|trans }}</span><span class="bo-form-label__required" aria-hidden="true">*</span>
                            </label>
                            <select class="form-select" id="combinations-tax-rule" name="tax_rule" required data-testid="combinations-tax-rule"
                                    data-bo-pse-price-with-tax-target="taxRule" data-action="change->bo-pse-price-with-tax#onTaxRuleChange">
                                <option value="">{{ 'Select a tax rule'|trans }}</option>
                                {% for rule in tax_rules %}
                                    <option value="{{ rule.id }}" {% if rule.id == tax_rule_id %}selected{% endif %}>{{ rule.title }}</option>
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    {% if available_currencies|default([])|length > 1 and not currency.is_default %}
                        <div class="form-check form-switch mb-2" data-testid="combinations-use-exchange-rate-wrapper">
                            <input class="form-check-input" type="checkbox" id="combinations-use-exchange-rate" name="use_exchange_rate" value="1" data-testid="combinations-use-exchange-rate">
                            <label class="form-check-label" for="combinations-use-exchange-rate">
                                {{ 'Convert prices from the default currency using the exchange rate'|trans }}
                            </label>
                        </div>
                    {% else %}
                        <input type="hidden" name="use_exchange_rate" value="0">
                    {% endif %}

                    {{ safe_hook('product.before-combinations', { location: 'product_before_combinations' }) }}
                    {{ safe_hook('product.combinations-list-caption', { location: 'product_combinations_list_caption' }) }}

                    <div id="combinations-sort-failure" data-testid="combinations-sort-failure" hidden>
                        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
                            <span>{{ 'The new order of the combinations was not saved.'|trans }}</span>
                            <a class="btn btn-sm btn-outline-danger" href="{{ path('admin.products.update', { product_id: product.id, current_tab: 'pse', combinations_currency_id: currency.id, sale_unit_id: sale_unit_values.sale_unit.id|default(null) }) }}">{{ 'Reload the grid'|trans }}</a>
                        </div>
                    </div>

                    <div class="alert alert-danger" role="alert" data-bo-pse-price-with-tax-target="error" data-testid="combinations-price-error" hidden>
                        {{ 'The price could not be converted with the tax rule. Type the price without taxes, or try again.'|trans }}
                    </div>

                    <div class="table-responsive">
                        <table class="table table-borderless bo-combinations-grid" data-testid="combinations-table"
                               data-controller="bo-sortable" data-bo-combinations-bulk-edit-target="sortable"
                               data-bo-sortable-item-value="tbody[data-row-id]"
                               data-bo-sortable-url-value="{{ path('admin.product.product-sale-element-position', { product_id: product.id }) }}"
                               data-bo-sortable-token-value="{{ assignToken() }}"
                               data-bo-sortable-param-name-value="product_sale_element_id"
                               data-bo-sortable-json-value="true"
                               data-bo-sortable-failure-element-value="#combinations-sort-failure"
                               data-bo-sortable-reindexed-fields-value="{{ ['onsale', 'isnew', 'visible']|json_encode|e('html_attr') }}">
                            <thead class="table-light">
                                <tr>
                                    <th class="bo-sortable-grip bo-combinations-grid__col-handle">
                                        <span class="visually-hidden bo-combinations-grid__grip">{{ 'Position'|trans }}</span>
                                        <input type="checkbox" class="form-check-input bo-combinations-grid__select" form="combinations-bulk-edit" autocomplete="off"
                                               data-bo-bulk-select-target="all" data-action="change->bo-bulk-select#toggleAll change->bo-combinations-bulk-edit#refresh"
                                               aria-label="{{ 'Select all'|trans }}" data-testid="combinations-select-all">
                                    </th>
                                    <th>{{ 'Combination'|trans }}</th>
                                    <th class="bo-combinations-grid__col-identifiers">{{ 'Identifiers'|trans }}</th>
                                    <th class="bo-combinations-grid__col-stock">{{ 'Stock and weight'|trans }}</th>
                                    <th class="bo-combinations-grid__col-promo"><span class="visually-hidden">{{ 'Promotion'|trans }}</span></th>
                                    <th class="bo-combinations-grid__col-price">{{ 'Price excl. taxes'|trans }}</th>
                                    <th class="bo-combinations-grid__col-price">{{ 'Price incl. taxes'|trans }}</th>
                                    {# A module returns its own <th> on product.combinations-table-header; counted, so that the lines spanning the grid span them too. #}
                                    {% set module_headers %}{{ safe_hook('product.combinations-table-header', { location: 'product_combinations_table_header', product: product.id, product_id: product.id }) }}{% endset %}
                                    {% set module_columns = (module_headers|split('<th')|length) - 1 %}
                                    {{ module_headers }}
                                    <th class="bo-combinations-grid__col-actions"><span class="visually-hidden">{{ 'Actions'|trans }}</span></th>
                                </tr>
                            </thead>
                            {% for row in pse_rows %}
                                {% set idx = loop.index0 %}
                                {% set field_id = 'combination-' ~ row.id %}
                                <tbody data-testid="combinations-row-{{ row.id }}" data-row-id="{{ row.id }}"
                                       data-bo-pse-price-with-tax-scope
                                       data-controller="bo-virtual-toggle" data-bo-virtual-toggle-mode-value="readonly">
                                    <tr>
                                        <td class="text-center bo-sortable-grip bo-combinations-grid__handle" rowspan="3" data-bo-sortable-handle title="{{ 'Drag to reorder'|trans }}">
                                            <i class="bi bi-grip-vertical bo-combinations-grid__grip" aria-hidden="true"></i>
                                            <label class="bo-combinations-grid__select" title="{{ 'Select %name%'|trans({ '%name%': row.label }) }}">
                                                <input type="checkbox" class="form-check-input" form="combinations-bulk-edit" value="{{ row.id }}" autocomplete="off"
                                                       data-bo-bulk-select-target="row" data-action="change->bo-bulk-select#onRow change->bo-combinations-bulk-edit#refresh"
                                                       aria-label="{{ 'Select %name%'|trans({ '%name%': row.label }) }}" data-testid="combinations-select-{{ row.id }}">
                                            </label>
                                        </td>
                                        <td class="bo-combinations-grid__identity" colspan="6">
                                            <span class="fw-semibold bo-combinations-grid__name">{{ row.label }}</span>
                                            <span class="badge rounded-pill border border-success text-success bg-transparent ms-2" data-bo-combination-default-target="badge" data-pse-id="{{ row.id }}" data-testid="combinations-default-badge-{{ row.id }}"{% if not row.isdefault %} hidden{% endif %}>{{ 'By default'|trans }}</span>
                                            <input type="radio" name="default_pse" value="{{ row.id }}" hidden {% if row.isdefault %}checked{% endif %}
                                                   aria-label="{{ 'Default combination'|trans }}"
                                                   data-bo-combination-default-target="radio" data-pse-id="{{ row.id }}">
                                            {{ include('@BackOfficeDefaultTwig/catalog/product/_combination_stock_fields.html.twig', { row: row, field_id: field_id, stock_policies: stock_policies, limited_policy: limited_policy, default_low_stock_threshold: default_low_stock_threshold }, with_context = false) }}
                                        </td>
                                        {# A module returns its own <td>, rowspan="3" to cover the three lines of the combination, on product.combinations-table-row. #}
                                        {{ safe_hook('product.combinations-table-row', { pse_id: row.id, pse: row.id, idx: idx, product: product.id, product_id: product.id }) }}
                                        {# datatable-sticky-actions is the lists' class: bo-overflow-dropdown lifts it above the next lines while the menu is open. #}
                                        <td class="text-end bo-combinations-grid__actions datatable-sticky-actions">
                                            <div class="d-inline-flex align-items-center gap-1">
                                                <input type="checkbox" class="btn-check bo-combinations-grid__visibility" id="{{ field_id }}-visible" name="visible[{{ idx }}]" value="1" autocomplete="off" data-bulk-field="visible"
                                                       {% if row.visible %}checked{% endif %} data-testid="combinations-visible-{{ row.id }}">
                                                <label class="btn btn-sm btn-outline-success btn-icon" for="{{ field_id }}-visible" title="{{ 'Visible in the shop'|trans }}">
                                                    <i class="bi bi-eye" aria-hidden="true"></i><i class="bi bi-eye-slash" aria-hidden="true"></i>
                                                    <span class="visually-hidden">{{ 'Visible in the shop'|trans }}</span>
                                                </label>
                                                {{ include('@BackOfficeDefaultTwig/catalog/product/_combination_row_actions.html.twig', { row: row, product: product }, with_context = false) }}
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>
                                            <div class="form-check mb-0">
                                                <input type="checkbox" class="form-check-input" id="{{ field_id }}-isnew" name="isnew[{{ idx }}]" value="1" data-bulk-field="isnew" {% if row.isnew %}checked{% endif %}>
                                                <label class="form-check-label" for="{{ field_id }}-isnew">{{ 'New'|trans }}</label>
                                            </div>
                                        </td>
                                        <td class="bo-combinations-grid__identifiers">
                                            <div class="bo-combinations-grid__field">
                                                <label for="{{ field_id }}-ref">{{ 'Ref.'|trans }}</label>
                                                <input type="hidden" name="product_sale_element_id[]" value="{{ row.id }}">
                                                <input type="text" id="{{ field_id }}-ref" name="reference[]" value="{{ row.ref }}" class="form-control form-control-sm bo-combinations-grid__ref">
                                            </div>
                                        </td>
                                        <td class="bo-combinations-grid__logistics">
                                            <div class="bo-combinations-grid__field">
                                                <label for="{{ field_id }}-quantity">{{ 'Stock'|trans }}</label>
                                                <input type="number" step="any" id="{{ field_id }}-quantity" name="quantity[]" value="{{ row.quantity }}" data-bulk-field="quantity" class="form-control form-control-sm text-end bo-combinations-grid__number">
                                            </div>
                                            {{ include('@BackOfficeDefaultTwig/catalog/product/_combination_sellable.html.twig', { row: row, note_class: 'text-body-secondary bo-combinations-grid__note' }, with_context = false) }}
                                        </td>
                                        <td></td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="any" name="price[]" value="{{ row.price }}" data-bulk-field="price" class="form-control text-end bo-combinations-grid__number"{% if row.price is null %} required{% endif %}
                                                       aria-label="{{ 'Price excl. taxes'|trans }}"
                                                       data-bo-pse-price-with-tax-target="priceExcl"
                                                       data-action="blur->bo-pse-price-with-tax#onPriceExclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </td>
                                        <td>
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="any" value="{{ row.price_with_tax }}" data-bulk-field="price-incl" class="form-control text-end bo-combinations-grid__number"
                                                       aria-label="{{ 'Price incl. taxes'|trans }}" data-testid="combinations-price-with-tax-{{ row.id }}"
                                                       data-bo-pse-price-with-tax-target="priceIncl"
                                                       data-action="blur->bo-pse-price-with-tax#onPriceInclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr class="bo-combinations-grid__last-line">
                                        <td>
                                            <button type="button" class="btn btn-sm btn-outline-secondary bo-datatable__details-toggle bo-combinations-grid__more"
                                                    data-controller="bo-datatable-details"
                                                    data-action="click->bo-datatable-details#toggle"
                                                    aria-expanded="false" aria-controls="{{ field_id }}-more"
                                                    data-testid="combinations-more-toggle-{{ row.id }}">
                                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                                <span class="bo-combinations-grid__more-closed">{{ 'Show the other fields'|trans }}</span>
                                                <span class="bo-combinations-grid__more-open">{{ 'Hide'|trans }}</span>
                                            </button>
                                        </td>
                                        <td class="bo-combinations-grid__identifiers">
                                            <div class="bo-combinations-grid__field">
                                                <label for="{{ field_id }}-gtin" title="{{ 'EAN-8, UPC-A, EAN-13 or GTIN-14'|trans }}">{{ 'GTIN'|trans }}</label>
                                                <input type="text" id="{{ field_id }}-gtin" name="ean_code[]" value="{{ row.ean_code }}" maxlength="32" inputmode="numeric" autocomplete="off"
                                                       class="form-control form-control-sm font-monospace bo-combinations-grid__gtin{% if row.gtin_shared_with is not empty %} border-warning{% endif %}"
                                                       data-testid="combinations-gtin-{{ row.id }}">
                                            </div>
                                            {% if row.gtin_shared_with is not empty %}
                                                <small class="text-warning-emphasis d-block bo-combinations-grid__note" data-testid="combinations-gtin-shared-{{ row.id }}">
                                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                                    {{ 'Also carried by: %others%'|trans({ '%others%': row.gtin_shared_with|join(', ') }) }}
                                                </small>
                                            {% endif %}
                                        </td>
                                        <td class="bo-combinations-grid__logistics">
                                            <div class="bo-combinations-grid__field">
                                                <label for="{{ field_id }}-weight">{{ 'Weight'|trans }}</label>
                                                <div class="input-group input-group-sm">
                                                    <input type="number" step="any" id="{{ field_id }}-weight" name="weight[]" value="{{ row.weight }}" data-bulk-field="weight" class="form-control text-end bo-combinations-grid__number">
                                                    <span class="input-group-text">{{ 'Kg'|trans }}</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="bo-combinations-grid__promo bo-combinations-grid__promo--start">
                                            <div class="form-check mb-0">
                                                <input type="checkbox" class="form-check-input" id="{{ field_id }}-onsale" name="onsale[{{ idx }}]" value="1" data-bulk-field="onsale" {% if row.onsale %}checked{% endif %}
                                                       data-bo-virtual-toggle-target="trigger" data-action="change->bo-virtual-toggle#update">
                                                <label class="form-check-label" for="{{ field_id }}-onsale">{{ 'On promotion'|trans }}</label>
                                            </div>
                                        </td>
                                        <td class="bo-combinations-grid__promo">
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="any" name="sale_price[]" value="{{ row.sale_price }}" data-bulk-field="sale-price" class="form-control text-end bo-combinations-grid__number"{% if not row.onsale %} readonly{% endif %}
                                                       aria-label="{{ 'Sale price excluding taxes'|trans }}"
                                                       data-bo-virtual-toggle-target="field"
                                                       data-bo-pse-price-with-tax-target="salePriceExcl"
                                                       data-action="blur->bo-pse-price-with-tax#onSalePriceExclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </td>
                                        <td class="bo-combinations-grid__promo bo-combinations-grid__promo--end">
                                            <div class="input-group input-group-sm">
                                                <input type="number" step="any" value="{{ row.sale_price_with_tax }}" data-bulk-field="sale-price-incl" class="form-control text-end bo-combinations-grid__number"{% if not row.onsale %} readonly{% endif %}
                                                       aria-label="{{ 'Sale price including taxes'|trans }}" data-testid="combinations-sale-price-with-tax-{{ row.id }}"
                                                       data-bo-virtual-toggle-target="field"
                                                       data-bo-pse-price-with-tax-target="salePriceIncl"
                                                       data-action="blur->bo-pse-price-with-tax#onSalePriceInclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </td>
                                        <td></td>
                                    </tr>
                                    <tr id="{{ field_id }}-more" hidden data-testid="combinations-more-{{ row.id }}">
                                        <td class="bo-combinations-grid__handle-cont"></td>
                                        <td colspan="{{ 7 + module_columns }}">
                                            {{ include('@BackOfficeDefaultTwig/catalog/product/_combination_more_fields.html.twig', { row: row, field_id: field_id, brand_options: brand_options, product_brand_title: product_brand_title }, with_context = false) }}
                                        </td>
                                    </tr>
                                    {# product.combinations-row keeps its contract: it is rendered inside a line, where a module returns its own <tr> lines, as under the line of a combination before. #}
                                    {% set module_lines %}{{ safe_hook('product.combinations-row', { pse_id: row.id, pse: row.id, idx: idx, product: product.id, product_id: product.id }) }}{% endset %}
                                    {% if module_lines|trim is not empty %}
                                        <tr class="bo-combinations-grid__module-lines" data-testid="combinations-module-lines-{{ row.id }}">{{ module_lines }}</tr>
                                    {% endif %}
                                    <tr class="bo-combinations-grid__band-end" aria-hidden="true"><td class="bo-combinations-grid__handle-cont"></td><td colspan="{{ 7 + module_columns }}"></td></tr>
                                </tbody>
                            {% endfor %}
                        </table>
                    </div>

                    {{ safe_hook('product.after-combinations', { location: 'product_after_combinations' }) }}

                    {# Shown by CSS once bo-unsaved-changes marks the form dirty. #}
                    <div class="bo-combinations-savebar" data-testid="combinations-savebar">
                        <button type="submit" class="btn btn-primary" data-testid="combinations-submit">
                            <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save changes'|trans }}
                        </button>
                        <button type="reset" class="btn btn-outline-secondary bo-combinations-savebar__discard" data-testid="combinations-discard">
                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i> {{ 'Cancel the changes'|trans }}
                        </button>
                    </div>
                </form>
                {# The boxes of the grid and the fields of the panel belong to this form (form="combinations-bulk-edit"): never sent, not reset with the grid. #}
                <dialog class="bo-side-panel" id="combinations-bulk-panel" aria-labelledby="combinations-bulk-panel-title"
                        data-bo-combinations-bulk-edit-target="panel"
                        data-action="close->bo-combinations-bulk-edit#closed keydown.esc->bo-combinations-bulk-edit#close"
                        data-testid="combinations-bulk-panel">
                    <button type="button" class="bo-side-panel__notch" aria-expanded="true" aria-controls="combinations-bulk-panel"
                            aria-label="{{ 'Bulk edit'|trans }}"
                            data-bo-combinations-bulk-edit-target="notch" data-action="bo-combinations-bulk-edit#fold"
                            data-testid="combinations-bulk-notch">
                        <i class="bi bi-chevron-right bo-side-panel__notch-fold" aria-hidden="true"></i>
                        <i class="bi bi-chevron-left bo-side-panel__notch-unfold" aria-hidden="true"></i>
                    </button>
                    <form id="combinations-bulk-edit" class="bo-side-panel__form" data-testid="combinations-bulk-form"
                          data-action="submit->bo-combinations-bulk-edit#apply">
                        <div class="bo-side-panel__header">
                            <h2 class="visually-hidden" id="combinations-bulk-panel-title">{{ 'Bulk edit'|trans }}</h2>
                            <button type="submit" class="btn btn-sm btn-primary" disabled
                                    data-bo-combinations-bulk-edit-target="apply" data-testid="combinations-bulk-apply">
                                {{ 'Apply to the selection'|trans }}
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-secondary"
                                    data-action="bo-combinations-bulk-edit#close" data-testid="combinations-bulk-close">{{ 'Cancel'|trans }}</button>
                        </div>
                        <div class="bo-side-panel__body">
                            <p class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="badge text-bg-primary" data-testid="combinations-bulk-count">
                                    <span data-bo-bulk-select-target="count">0</span>
                                    {{ 'selected'|trans }}
                                </span>
                                <button type="button" class="btn btn-sm btn-link p-0" data-action="bo-bulk-select#clear bo-combinations-bulk-edit#refresh"
                                        data-testid="combinations-bulk-clear">{{ 'Clear selection'|trans }}</button>
                            </p>
                            <p class="small text-muted mb-1" data-bo-combinations-bulk-edit-target="emptyHint" data-testid="combinations-bulk-empty">{{ 'Tick the combinations to change in the grid.'|trans }}</p>
                            <p class="small text-muted">{{ 'Leave a field untouched to keep its current value.'|trans }}</p>
                            <div class="row row-cols-1 row-cols-sm-2 g-2">
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-quantity">{{ 'Stock'|trans }}</label>
                                    <input type="number" step="any" id="combinations-bulk-quantity" class="form-control form-control-sm text-end"
                                           data-bulk-field="quantity" data-bo-combinations-bulk-edit-target="field"
                                           data-testid="combinations-bulk-quantity">
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-weight">{{ 'Weight'|trans }}</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="any" id="combinations-bulk-weight" class="form-control text-end"
                                               data-bulk-field="weight" data-bo-combinations-bulk-edit-target="field"
                                               data-testid="combinations-bulk-weight">
                                        <span class="input-group-text">{{ 'Kg'|trans }}</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-price">{{ 'Price excl. taxes'|trans }}</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="any" id="combinations-bulk-price" class="form-control text-end"
                                               data-bulk-field="price" data-bo-combinations-bulk-edit-target="field"
                                               data-action="input->bo-combinations-bulk-edit#onPriceInput blur->bo-combinations-bulk-edit#onPriceBlur"
                                               data-testid="combinations-bulk-price">
                                        <span class="input-group-text">{{ currency.symbol }}</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-price-incl">{{ 'Price incl. taxes'|trans }}</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="any" id="combinations-bulk-price-incl" class="form-control text-end"
                                               data-bulk-field="price-incl" data-bo-combinations-bulk-edit-target="field"
                                               data-action="input->bo-combinations-bulk-edit#onPriceInput blur->bo-combinations-bulk-edit#onPriceBlur"
                                               data-testid="combinations-bulk-price-incl">
                                        <span class="input-group-text">{{ currency.symbol }}</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-onsale">{{ 'On promotion'|trans }}</label>
                                    <select id="combinations-bulk-onsale" class="form-select form-select-sm"
                                            data-bulk-field="onsale" data-bo-combinations-bulk-edit-target="field"
                                            data-testid="combinations-bulk-onsale">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="1">{{ 'Yes'|trans }}</option>
                                        <option value="0">{{ 'No'|trans }}</option>
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-sale-price">{{ 'Sale price excluding taxes'|trans }}</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="any" id="combinations-bulk-sale-price" class="form-control text-end"
                                               data-bulk-field="sale-price" data-bo-combinations-bulk-edit-target="field"
                                               data-action="input->bo-combinations-bulk-edit#onPriceInput blur->bo-combinations-bulk-edit#onPriceBlur"
                                               data-testid="combinations-bulk-sale-price">
                                        <span class="input-group-text">{{ currency.symbol }}</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-sale-price-incl">{{ 'Sale price including taxes'|trans }}</label>
                                    <div class="input-group input-group-sm">
                                        <input type="number" step="any" id="combinations-bulk-sale-price-incl" class="form-control text-end"
                                               data-bulk-field="sale-price-incl" data-bo-combinations-bulk-edit-target="field"
                                               data-action="input->bo-combinations-bulk-edit#onPriceInput blur->bo-combinations-bulk-edit#onPriceBlur"
                                               data-testid="combinations-bulk-sale-price-incl">
                                        <span class="input-group-text">{{ currency.symbol }}</span>
                                    </div>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-isnew">{{ 'New'|trans }}</label>
                                    <select id="combinations-bulk-isnew" class="form-select form-select-sm"
                                            data-bulk-field="isnew" data-bo-combinations-bulk-edit-target="field"
                                            data-testid="combinations-bulk-isnew">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="1">{{ 'Yes'|trans }}</option>
                                        <option value="0">{{ 'No'|trans }}</option>
                                    </select>
                                </div>
                                <div class="col">
                                    <label class="form-label small mb-1" for="combinations-bulk-visible">{{ 'Visible in the shop'|trans }}</label>
                                    <select id="combinations-bulk-visible" class="form-select form-select-sm"
                                            data-bulk-field="visible" data-bo-combinations-bulk-edit-target="field"
                                            data-testid="combinations-bulk-visible">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="1">{{ 'Yes'|trans }}</option>
                                        <option value="0">{{ 'No'|trans }}</option>
                                    </select>
                                </div>
                                <div class="col-12">
                                    <label class="form-label small mb-1" for="combinations-bulk-brand">{{ 'Manufacturer'|trans }}</label>
                                    <select id="combinations-bulk-brand" class="form-select form-select-sm"
                                            data-bulk-field="brand" data-bo-combinations-bulk-edit-target="field"
                                            data-testid="combinations-bulk-brand">
                                        <option value="">{{ 'Unchanged'|trans }}</option>
                                        <option value="0">{{ product_brand_title is not null ? 'Brand of the product (%brand%)'|trans({ '%brand%': product_brand_title }) : 'Brand of the product'|trans }}</option>
                                        {% for brand in brand_options %}
                                            <option value="{{ brand.id }}">{{ brand.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            </div>
                        </div>
                    </form>
                </dialog>
            {% else %}
                {% if default_pse is null %}
                    <div class="alert alert-warning" data-testid="default-pse-missing">
                        {{ 'No default product sale element. Please contact your administrator.'|trans }}
                    </div>
                {% else %}
                    {% if template_attributes is not empty %}
                        <div class="alert alert-info" data-testid="combinations-empty-hint">
                            {{ 'This product has no combination yet. The default pricing below is used while no combination exists.'|trans }}
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('admin.product.combination.defaut-price.update') }}"
                          data-testid="default-pse-form"
                          data-controller="bo-pse-price-with-tax"
                          data-bo-pse-price-with-tax-calc-url-value="{{ path('admin.product.calculate-price') }}"
                          data-bo-pse-price-with-tax-product-id-value="{{ product.id }}">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <input type="hidden" name="product_id" value="{{ product.id }}">
                        <input type="hidden" name="product_sale_element_id" value="{{ default_pse.id }}">
                        <input type="hidden" name="isdefault" value="1">
                        <input type="hidden" name="reference" value="{{ default_pse.ref }}">
                        <input type="hidden" name="currency" value="{{ currency.id }}">
                        <input type="hidden" name="current_tab" value="pse">

                        <p class="text-muted">{{ 'The default pricing is used when no combination is defined.'|trans }}</p>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label required" for="default_pse_tax_rule">
                                    <span class="bo-form-label__text">{{ 'Tax rule'|trans }}</span><span class="bo-form-label__required" aria-hidden="true">*</span>
                                </label>
                                <select class="form-select" id="default_pse_tax_rule" name="tax_rule" required
                                        data-bo-pse-price-with-tax-target="taxRule"
                                        data-action="change->bo-pse-price-with-tax#onTaxRuleChange">
                                    <option value="">{{ 'Select a tax rule'|trans }}</option>
                                    {% for rule in tax_rules %}
                                        <option value="{{ rule.id }}" {% if rule.id == tax_rule_id %}selected{% endif %}>{{ rule.title }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <span class="text-muted small">{{ 'Currency'|trans }} : <strong>{{ currency.name }}</strong> ({{ currency.symbol }})</span>
                            </div>
                        </div>

                        <div class="alert alert-danger" role="alert" data-bo-pse-price-with-tax-target="error" data-testid="default-pse-price-error" hidden>
                            {{ 'The price could not be converted with the tax rule. Type the price without taxes, or try again.'|trans }}
                        </div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h2 class="h6 mb-3" data-testid="default-pse-pricing-title">{{ 'Pricing'|trans }}</h2>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_price">{{ 'Product price excluding taxes'|trans }}</label>
                                            <div class="input-group">
                                                <input type="number" step="any" id="default_pse_price" name="price" value="{{ default_pse.price }}" class="form-control" required
                                                       data-bo-pse-price-with-tax-target="priceExcl"
                                                       data-action="blur->bo-pse-price-with-tax#onPriceExclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_price_with_tax">{{ 'Product price including taxes'|trans }}</label>
                                            <div class="input-group">
                                                <input type="number" step="any" id="default_pse_price_with_tax" name="price_with_tax" value="" class="form-control" placeholder="{{ 'Auto-computed from price + tax rule'|trans }}"
                                                       data-bo-pse-price-with-tax-target="priceIncl"
                                                       data-action="blur->bo-pse-price-with-tax#onPriceInclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </div>

                                        {{ safe_hook('product.details-pricing-form', { product: product.id, location: 'product_details_pricing_form' }) }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h2 class="h6 mb-3" data-testid="default-pse-stock-title">{{ 'Stock'|trans }}</h2>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_ean">{{ 'GTIN'|trans }}</label>
                                            <input type="text" id="default_pse_ean" name="ean_code" value="{{ default_pse.ean_code }}" maxlength="32" inputmode="numeric" autocomplete="off"
                                                   class="form-control{% if default_pse.gtin_shared_with is not empty %} border-warning{% endif %}"
                                                   aria-describedby="default_pse_ean_help" data-testid="default-pse-gtin">
                                            <div id="default_pse_ean_help" class="form-text">{{ 'EAN-8, UPC-A, EAN-13 or GTIN-14. The check digit is verified.'|trans }}</div>
                                            {% if default_pse.gtin_shared_with is not empty %}
                                                <div class="form-text text-warning-emphasis" data-testid="default-pse-gtin-shared">
                                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                                    {{ 'Also carried by: %others%'|trans({ '%others%': default_pse.gtin_shared_with|join(', ') }) }}
                                                </div>
                                            {% endif %}
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_mpn">{{ 'Manufacturer part number'|trans }}</label>
                                            <input type="text" id="default_pse_mpn" name="mpn" value="{{ default_pse.mpn }}" maxlength="255" autocomplete="off" class="form-control" data-testid="default-pse-mpn">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_manufacturer">{{ 'Manufacturer'|trans }}</label>
                                            <select id="default_pse_manufacturer" name="manufacturer_brand_id" class="form-select" data-testid="default-pse-manufacturer">
                                                <option value="0">{{ product_brand_title is not null ? 'Brand of the product (%brand%)'|trans({ '%brand%': product_brand_title }) : 'Brand of the product'|trans }}</option>
                                                {% for brand in brand_options %}
                                                    <option value="{{ brand.id }}"{{ brand.id == default_pse.manufacturer_brand_id ? ' selected' }}>{{ brand.title }}</option>
                                                {% endfor %}
                                            </select>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_weight">{{ 'Weight'|trans }}</label>
                                            <div class="input-group">
                                                <input type="number" step="any" id="default_pse_weight" name="weight" value="{{ default_pse.weight }}" class="form-control">
                                                <span class="input-group-text">{{ 'Kg'|trans }}</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_quantity">{{ 'Stock quantity'|trans }}</label>
                                            <input type="number" step="any" id="default_pse_quantity" name="quantity" value="{{ default_pse.quantity }}" class="form-control" required>
                                            {{ include('@BackOfficeDefaultTwig/catalog/product/_combination_sellable.html.twig', { row: default_pse, note_class: 'form-text' }, with_context = false) }}
                                        </div>

                                        <div class="mb-3" data-controller="bo-stock-policy" data-bo-stock-policy-limited-value="{{ limited_policy }}">
                                            <label class="form-label" for="default_pse_out_of_stock_policy">{{ 'At zero stock'|trans }}</label>
                                            <select id="default_pse_out_of_stock_policy" name="out_of_stock_policy" class="form-select"
                                                    data-bo-stock-policy-target="policy" data-action="change->bo-stock-policy#toggle" data-testid="default-pse-policy">
                                                {% for policy in stock_policies %}
                                                    <option value="{{ policy.value }}"{{ policy.value == default_pse.out_of_stock_policy ? ' selected' }}>{{ policy.label|trans }}</option>
                                                {% endfor %}
                                            </select>
                                            <div class="mt-2{{ default_pse.out_of_stock_policy != limited_policy ? ' d-none' }}" data-bo-stock-policy-target="limit">
                                                <label class="form-label" for="default_pse_preorder_limit">{{ 'Preorder limit'|trans }}</label>
                                                <input type="number" step="any" id="default_pse_preorder_limit" name="preorder_limit" value="{{ default_pse.preorder_limit }}" class="form-control" data-testid="default-pse-preorder-limit">
                                                <div class="form-text">{{ 'Units that can be sold below zero.'|trans }}</div>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_restock_date">{{ 'Restock date'|trans }}</label>
                                            <input type="date" id="default_pse_restock_date" name="restock_date" value="{{ default_pse.restock_date }}" class="form-control" data-testid="default-pse-restock-date">
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_low_stock_threshold">{{ 'Low stock threshold'|trans }}</label>
                                            <input type="number" step="any" min="0" id="default_pse_low_stock_threshold" name="low_stock_threshold" value="{{ default_pse.low_stock_threshold }}" placeholder="{{ default_low_stock_threshold }}" class="form-control" data-testid="default-pse-low-stock-threshold">
                                            <div class="form-text">{{ 'Empty: the threshold of the shop applies'|trans }}</div>
                                        </div>

                                        {{ safe_hook('product.details-details-form', { product: product.id, location: 'product_details_details_form' }) }}
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="card h-100">
                                    <div class="card-body">
                                        <h2 class="h6 mb-3" data-testid="default-pse-promo-title">{{ 'Promotion'|trans }}</h2>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_sale_price">{{ 'Sale price excluding taxes'|trans }}</label>
                                            <div class="input-group">
                                                <input type="number" step="any" id="default_pse_sale_price" name="sale_price" value="{{ default_pse.sale_price }}" class="form-control" required
                                                       data-bo-pse-price-with-tax-target="salePriceExcl"
                                                       data-action="blur->bo-pse-price-with-tax#onSalePriceExclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </div>

                                        <div class="mb-3">
                                            <label class="form-label" for="default_pse_sale_price_with_tax">{{ 'Sale price including taxes'|trans }}</label>
                                            <div class="input-group">
                                                <input type="number" step="any" id="default_pse_sale_price_with_tax" name="sale_price_with_tax" value="" class="form-control" placeholder="{{ 'Auto-computed from sale price + tax rule'|trans }}"
                                                       data-bo-pse-price-with-tax-target="salePriceIncl"
                                                       data-action="blur->bo-pse-price-with-tax#onSalePriceInclBlur">
                                                <span class="input-group-text">{{ currency.symbol }}</span>
                                            </div>
                                        </div>

                                        <div class="form-check mb-2">
                                            <input type="checkbox" class="form-check-input" id="default_pse_onsale" name="onsale" value="1" {% if default_pse.onsale %}checked{% endif %}>
                                            <label class="form-check-label" for="default_pse_onsale">{{ 'On sale'|trans }}</label>
                                        </div>

                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input" id="default_pse_isnew" name="isnew" value="1" {% if default_pse.isnew %}checked{% endif %}>
                                            <label class="form-check-label" for="default_pse_isnew">{{ 'New product'|trans }}</label>
                                        </div>

                                        {{ safe_hook('product.details-promotion-form', { product: product.id, location: 'product_details_promotion_form' }) }}
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-end mt-3">
                            <button type="submit" class="btn btn-primary" data-testid="default-pse-submit">
                                <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                            </button>
                        </div>
                    </form>
                {% endif %}
            {% endif %}
        </div>
    </div>

    {% if sale_unit_values|default(null) is not null %}
        {{ include('@BackOfficeDefaultTwig/catalog/product/_sale_unit_values.html.twig') }}
    {% endif %}

    {% if group_prices|default(null) is not null %}
        {{ include('@BackOfficeDefaultTwig/catalog/product/_group_prices.html.twig') }}
    {% endif %}

    {% component 'BoConfirmDialog' with {
        id: 'pse-delete-modal',
        title: 'Delete combination',
        formAction: path('admin.product.combination.delete'),
        prefillTrigger: 'data-pse-id',
        prefillInput: 'product_sale_element_id',
    } %}
        {% block body %}
            <input type="hidden" name="product_id" value="{{ product.id }}">
            <input type="hidden" name="product_sale_element_id" data-bo-prefill-modal-target="input">
            <p class="mb-0">{{ 'Are you sure you want to delete this combination?'|trans }}</p>
            {{ safe_hook('product.combination-delete-form', { location: 'product_combination_delete_form' }) }}
        {% endblock %}
    {% endcomponent %}

    {% if template_attributes is not empty %}
        <div class="modal fade" id="combination-creation-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <form method="post" action="{{ path('admin.product.combination.add') }}"
                      data-controller="bo-combination-creation" data-testid="combination-creation-form">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Add a combination'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="product_id" value="{{ product.id }}">
                            <input type="hidden" name="combination_attributes" data-bo-combination-creation-target="output">

                            <p class="text-muted">{{ 'Pick one value per attribute to define this combination.'|trans }}</p>

                            {% for attribute in template_attributes %}
                                <div class="mb-3">
                                    <label class="form-label" for="combination-creation-attr-{{ attribute.id }}">{{ attribute.title }}</label>
                                    <select id="combination-creation-attr-{{ attribute.id }}"
                                            class="form-select"
                                            data-attribute-id="{{ attribute.id }}"
                                            data-bo-combination-creation-target="select"
                                            data-action="change->bo-combination-creation#sync"
                                            data-testid="combination-creation-select-{{ attribute.id }}">
                                        <option value="">{{ '- Not used -'|trans }}</option>
                                        {% for value in attribute.values %}
                                            <option value="{{ value.id }}">{{ value.title }}</option>
                                        {% endfor %}
                                    </select>
                                </div>
                            {% endfor %}

                            <div class="alert alert-danger d-none" data-bo-combination-creation-target="error" role="alert"></div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                            <button type="submit" class="btn btn-primary" data-bo-combination-creation-target="submit" data-testid="combination-creation-submit">
                                <i class="bi bi-plus-circle" aria-hidden="true"></i> {{ 'Create this combination'|trans }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="modal fade" id="combination-builder-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg modal-dialog-scrollable">
                <form method="post" action="{{ path('admin.product.combination.build') }}"
                      data-controller="bo-combination-builder" data-testid="combination-builder-form">
                    <input type="hidden" name="_token" value="{{ assignToken() }}">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h1 class="modal-title fs-5">{{ 'Combination builder'|trans }}</h1>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" name="product_id" value="{{ product.id }}">
                            <input type="hidden" name="currency" value="{{ currency.id }}">

                            {% if has_combinations %}
                                <div class="alert alert-warning" role="alert">
                                    {{ 'All existing combinations will be deleted and recreated from the selected attribute values.'|trans }}
                                </div>
                            {% else %}
                                <p class="text-muted">{{ 'Tick attribute values to generate every possible combination at once.'|trans }}</p>
                            {% endif %}

                            <div class="row g-3">
                                <div class="col-md-7">
                                    <div class="border rounded p-3 bg-light">
                                        {% for attribute in template_attributes %}
                                            <fieldset class="mb-3" data-testid="combination-builder-attr-{{ attribute.id }}">
                                                <legend class="fs-6 fw-bold">{{ attribute.title }}</legend>
                                                {% for value in attribute.values %}
                                                    <div class="form-check">
                                                        <input class="form-check-input"
                                                               type="checkbox"
                                                               name="attribute_av[]"
                                                               value="{{ attribute.id }}:{{ value.id }}"
                                                               id="combination-builder-{{ attribute.id }}-{{ value.id }}"
                                                               data-attribute-id="{{ attribute.id }}"
                                                               data-bo-combination-builder-target="checkbox"
                                                               data-action="change->bo-combination-builder#recount">
                                                        <label class="form-check-label" for="combination-builder-{{ attribute.id }}-{{ value.id }}">{{ value.title }}</label>
                                                    </div>
                                                {% endfor %}
                                            </fieldset>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <h2 class="h6">{{ 'Default values for new combinations'|trans }}</h2>

                                    <div class="mb-3">
                                        <label class="form-label" for="combination-builder-reference">{{ 'Reference'|trans }}</label>
                                        <input type="text" class="form-control" id="combination-builder-reference" name="reference" placeholder="{{ 'Combination reference'|trans }}">
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="combination-builder-price">{{ 'Price (excl. taxes)'|trans }}</label>
                                        <div class="input-group">
                                            <input type="number" step="any" class="form-control" id="combination-builder-price" name="price" value="{{ default_pse.price|default(0) }}" required>
                                            <span class="input-group-text">{{ currency.symbol }}</span>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="combination-builder-sale-price">{{ 'Sale price (excl. taxes)'|trans }}</label>
                                        <div class="input-group">
                                            <input type="number" step="any" class="form-control" id="combination-builder-sale-price" name="sale_price" value="{{ default_pse.sale_price|default(0) }}">
                                            <span class="input-group-text">{{ currency.symbol }}</span>
                                        </div>
                                    </div>
                                    <div class="row g-2 mb-3">
                                        <div class="col-6">
                                            <label class="form-label" for="combination-builder-quantity">{{ 'Stock'|trans }}</label>
                                            <input type="number" step="1" min="1" class="form-control" id="combination-builder-quantity" name="quantity" value="{{ default_pse.quantity|default(1) ?: 1 }}" required>
                                        </div>
                                        <div class="col-6">
                                            <label class="form-label" for="combination-builder-weight">{{ 'Weight'|trans }}</label>
                                            <div class="input-group">
                                                <input type="number" step="any" class="form-control" id="combination-builder-weight" name="weight" value="{{ default_pse.weight|default(0) }}">
                                                <span class="input-group-text">{{ 'Kg'|trans }}</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label" for="combination-builder-ean">{{ 'GTIN'|trans }}</label>
                                        <input type="text" class="form-control" id="combination-builder-ean" name="ean_code" maxlength="32" inputmode="numeric" autocomplete="off">
                                    </div>
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input" id="combination-builder-onsale" name="onsale" value="1">
                                        <label class="form-check-label" for="combination-builder-onsale">{{ 'On sale'|trans }}</label>
                                    </div>
                                    <div class="form-check mb-3">
                                        <input type="checkbox" class="form-check-input" id="combination-builder-isnew" name="isnew" value="1">
                                        <label class="form-check-label" for="combination-builder-isnew">{{ 'New product'|trans }}</label>
                                    </div>

                                    <div class="alert alert-secondary mb-0" role="status">
                                        <strong data-bo-combination-builder-target="counter" data-testid="combination-builder-counter">0</strong>
                                        {{ 'combinations will be generated.'|trans }}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                            <button type="submit" class="btn btn-primary" data-bo-combination-builder-target="submit" disabled data-testid="combination-builder-submit">
                                <i class="bi bi-stars" aria-hidden="true"></i> {{ 'Create combinations'|trans }}
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    {{ safe_hook('product.combinations-tab.bottom', { product: product.id }) }}
</div>
