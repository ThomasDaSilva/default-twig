<div class="col-lg-6">
    <div class="card shadow-sm border-0 h-100">
        <div class="card-body">
            <h2 class="h5 mb-1">{{ relation.title }}</h2>
            <p class="text-muted">{{ relation.description ?? '' }}</p>

            <form method="post" action="{{ relation.add_url }}" class="mb-3" data-testid="{{ relation.id_prefix }}-form"
                  data-controller="bo-relation-picker"
                  data-bo-relation-picker-url-value="{{ relation.available_url }}"
                  data-bo-relation-picker-empty-label-value="{{ 'No matching product.'|trans }}">
                <input type="hidden" name="product_id" value="{{ product.id }}">
                <input type="hidden" name="type_code" value="{{ relation.type_code }}">
                <input type="hidden" name="current_tab" value="related">
                <input type="hidden" name="_token" value="{{ token }}">
                <input type="hidden" name="associated_product_id" value="" data-bo-relation-picker-target="value">
                <label for="{{ relation.id_prefix }}-search" class="form-label">{{ 'Product'|trans }}</label>
                <div class="bo-relation-picker">
                    <div class="input-group">
                        <input type="text"
                               id="{{ relation.id_prefix }}-search"
                               class="form-control"
                               autocomplete="off"
                               role="combobox"
                               aria-autocomplete="list"
                               aria-expanded="false"
                               aria-controls="{{ relation.id_prefix }}-menu"
                               placeholder="{{ 'Search by reference or title…'|trans }}"
                               data-testid="{{ relation.id_prefix }}-search"
                               data-bo-relation-picker-target="input"
                               data-action="input->bo-relation-picker#search focus->bo-relation-picker#open blur->bo-relation-picker#close keydown->bo-relation-picker#key">
                        <button type="submit" class="btn btn-primary" disabled
                                aria-label="{{ 'Add'|trans }}"
                                data-testid="{{ relation.id_prefix }}-add"
                                data-bo-relation-picker-target="submit">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <ul class="bo-tag-picker__menu bo-relation-picker__menu d-none"
                        id="{{ relation.id_prefix }}-menu"
                        role="listbox"
                        data-bo-relation-picker-target="menu"></ul>
                </div>
                <small class="form-text text-muted">{{ 'Select a product and click + to add it to this block'|trans }}</small>
            </form>

            {% set relation_rows = [] %}
            {% for row in relation.rows %}
                {% set relation_rows = relation_rows|merge([{
                    'id': row.id,
                    'associated_product_id': row.associated_product_id,
                    'title': row.title,
                    'position': row.position,
                    '_actions': [
                        row_action('delete', 'Remove'|trans, null, '#' ~ relation.id_prefix ~ '-delete', 'UPDATE', 'admin.product', { 'associated-product-id': row.associated_product_id }),
                    ],
                }]) %}
            {% endfor %}

            {{ component('BoDataTable', {
                id: relation.id_prefix,
                columns: [
                    column('associated_product_id', 'ID'|trans, hideBelow: 'md'),
                    column('title', 'Related product'|trans),
                    column('position', 'Position'|trans, 'center', hideBelow: 'lg'),
                    column_actions(),
                ],
                rows: relation_rows,
                emptyMessage: 'This product has no relation of this type'|trans,
                tbodyAttributes: {
                    'data-controller': 'bo-sortable',
                    'data-bo-sortable-url-value': relation.position_url ~ '?product_id=' ~ product.id ~ '&current_tab=related&mode=1',
                    'data-bo-sortable-token-value': token,
                    'data-bo-sortable-param-name-value': 'association_id',
                },
                extraColumnsHeaderHook: relation.header_hook,
                headerHookContext: { product_id: product.id, type_code: relation.type_code },
                extraColumnsHook: relation.row_hook,
                rowHookContext: { product_id: product.id, type_code: relation.type_code },
                rowHookArgs: { accessory_id: 'associated_product_id' },
            }) }}
        </div>
    </div>
</div>
