{% set data = this.data %}

<div data-testid="bo-dashboard">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex flex-wrap gap-1" data-testid="dashboard-period-options">
            {% for option in data.periodOptions %}
                <a href="{{ option.url }}" class="btn btn-sm {{ option.active ? 'btn-primary' : 'btn-outline-secondary' }}"
                   data-testid="dashboard-period-{{ option.value }}">{{ option.label }}</a>
            {% endfor %}
        </div>
        <span class="text-muted small">
            {{ data.range.from|date('d/m/Y') }} - {{ data.range.to|date('d/m/Y') }}
        </span>
    </div>

    {% if data.alerts %}
        <div class="row g-2 mb-3" data-testid="dashboard-alerts">
            {% for alert in data.alerts %}
                <div class="col-md-6">
                    <a href="{{ alert.href }}" class="alert alert-{{ alert.level }} d-flex align-items-center gap-2 mb-0 text-decoration-none"
                       data-testid="dashboard-alert">
                        <i class="bi {{ alert.icon }}" aria-hidden="true"></i>
                        <span>{{ alert.label }}</span>
                    </a>
                </div>
            {% endfor %}
        </div>
    {% endif %}

    <div class="row g-3 mb-3" data-testid="dashboard-kpis">
        {% for kpi in data.kpis %}
            {% set wrapper_tag = kpi.href ? 'a' : 'div' %}
            <div class="col-md-6 col-lg-3">
                <{{ wrapper_tag }}{% if kpi.href %} href="{{ kpi.href }}"{% endif %} class="card h-100 shadow-sm border-0 bo-kpi text-decoration-none text-body" data-testid="{{ kpi.testid }}">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between">
                            <div class="rounded-circle bg-{{ kpi.accent }}-subtle text-{{ kpi.accent }} d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                                <i class="bi {{ kpi.icon }} fs-5" aria-hidden="true"></i>
                            </div>
                            {% if kpi.variationPercent is not null %}
                                {% set dir = kpi.variationDirection() %}
                                <span class="bo-kpi__delta bo-kpi__delta--{{ dir }}">
                                    {% if dir == 'up' %}<i class="bi bi-arrow-up-short"></i>{% elseif dir == 'down' %}<i class="bi bi-arrow-down-short"></i>{% else %}<i class="bi bi-dash"></i>{% endif %}
                                    {{ kpi.variationPercent|abs|number_format(1, ',', ' ') }} %
                                </span>
                            {% endif %}
                        </div>
                        <div class="text-muted small mt-3">{{ kpi.label }}</div>
                        <div class="h4 mb-0 fw-semibold"><span dir="ltr">{{ kpi.value }}</span></div>
                    </div>
                </{{ wrapper_tag }}>
            </div>
        {% endfor %}
    </div>

    {% if data.showRevenueChart or data.showOrderStatus %}
    <div class="row g-3 mb-3">
        {% if data.showRevenueChart %}
        <div class="col-lg-8">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-body-tertiary d-flex flex-wrap gap-2 align-items-center justify-content-between">
                    <h2 class="h6 mb-0"><i class="bi bi-graph-up me-2 text-primary"></i>{{ 'Revenue trend'|trans }}</h2>
                    <span class="text-muted small">{{ 'Daily, TTC'|trans }}</span>
                </div>
                <div class="card-body d-flex flex-column">
                    <div class="bo-chart-canvas flex-grow-1">
                        <canvas data-controller="bo-chart"
                                data-bo-chart-type-value="line"
                                data-bo-chart-format-value="currency"
                                data-bo-chart-label-value="{{ 'Revenue'|trans }}"
                                data-bo-chart-labels-value="{{ data.chart.labels|json_encode|e('html_attr') }}"
                                data-bo-chart-data-value="{{ data.chart.revenue|json_encode|e('html_attr') }}"></canvas>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}
        {% if data.showOrderStatus %}
        <div class="col-lg-4">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-body-tertiary d-flex align-items-center">
                    <h2 class="h6 mb-0"><i class="bi bi-pie-chart me-2 text-info"></i>{{ 'Order status'|trans }}</h2>
                </div>
                <div class="card-body">
                    {% if data.statusBreakdown %}
                        <div class="bo-chart-canvas" style="height: 200px;">
                            <canvas data-controller="bo-chart"
                                    data-bo-chart-type-value="doughnut"
                                    data-bo-chart-labels-value="{{ data.statusBreakdown|map(s => s.title)|json_encode|e('html_attr') }}"
                                    data-bo-chart-data-value="{{ data.statusBreakdown|map(s => s.count)|json_encode|e('html_attr') }}"
                                    data-bo-chart-colors-value="{{ data.statusBreakdown|map(s => s.color)|json_encode|e('html_attr') }}"></canvas>
                        </div>
                        <ul class="list-unstyled small mt-3 mb-0">
                            {% for status in data.statusBreakdown %}
                                <li class="d-flex align-items-center justify-content-between py-1">
                                    <span class="d-inline-flex align-items-center gap-2">
                                        <span class="bo-kpi__dot" style="background-color: {{ status.color }};"></span>
                                        {{ status.title }}
                                    </span>
                                    <span class="text-muted">{{ status.count }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    {% else %}
                        <p class="text-muted text-center my-4">{{ 'No order yet'|trans }}</p>
                    {% endif %}
                </div>
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if data.showRecentOrders or data.showTopProducts %}
    <div class="row g-3 mb-3">
        {% if data.showRecentOrders %}
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-body-tertiary d-flex align-items-center">
                    <h2 class="h6 mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>{{ 'Recent orders'|trans }}</h2>
                </div>
                <ul class="list-group list-group-flush small">
                    {% for order in data.recentOrders %}
                        <li class="list-group-item d-flex align-items-center justify-content-between gap-2" data-testid="dashboard-recent-order">
                            <div class="text-truncate">
                                <a href="{{ path('admin.order.update.view', { order_id: order.id }) }}" class="fw-semibold text-decoration-none">{{ order.ref }}</a>
                                {% if order.customer %}
                                    <span class="text-muted ms-2">{{ order.customer.firstname }} {{ order.customer.lastname }}</span>
                                {% endif %}
                            </div>
                            <span class="badge text-bg-light" dir="ltr">{{ (data.recentOrderAmounts[order.id] ?? 0)|number_format(2, ',', ' ') }}&nbsp;{{ order.currency.symbol }}</span>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted text-center">{{ 'No recent order'|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}

        {% if data.showTopProducts %}
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-0">
                <div class="card-header bg-body-tertiary d-flex align-items-center">
                    <h2 class="h6 mb-0"><i class="bi bi-trophy me-2 text-warning"></i>{{ 'Top selling products'|trans }}</h2>
                </div>
                <ul class="list-group list-group-flush small">
                    {% for product in data.topProducts %}
                        <li class="list-group-item d-flex align-items-center justify-content-between gap-2" data-testid="dashboard-top-product">
                            <div class="text-truncate">
                                {% if product.id %}
                                    <a href="{{ path('admin.products.update', { product_id: product.id }) }}" class="fw-semibold text-decoration-none">{{ product.title }}</a>
                                {% else %}
                                    <span class="fw-semibold">{{ product.title }}</span>
                                {% endif %}
                                <span class="text-muted ms-2">{{ product.ref }}</span>
                            </div>
                            <div class="text-end">
                                <div class="fw-semibold">{{ product.quantity }} {{ 'sold'|trans }}</div>
                                <div class="text-muted"><span dir="ltr">{{ product.revenue|number_format(0, ',', ' ') }} €</span></div>
                            </div>
                        </li>
                    {% else %}
                        <li class="list-group-item text-muted text-center">{{ 'No sales yet in this period'|trans }}</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        {% endif %}
    </div>
    {% endif %}

    {% if data.showLowStock %}
    <div class="card shadow-sm border-0">
        <div class="card-header bg-body-tertiary d-flex align-items-center">
            <h2 class="h6 mb-0"><i class="bi bi-exclamation-triangle me-2 text-danger"></i>{{ 'Low stock'|trans }} <small class="text-muted">(&le;&nbsp;{{ data.lowStockThreshold }})</small></h2>
        </div>
        <ul class="list-group list-group-flush small">
            {% for pse in data.lowStockProducts %}
                <li class="list-group-item d-flex align-items-center justify-content-between gap-2" data-testid="dashboard-low-stock">
                    <a href="{{ path('admin.products.update', { product_id: pse.productId }) }}" class="text-decoration-none">
                        {{ pse.product.title|default(pse.ref) }} <span class="text-muted ms-2">{{ pse.ref }}</span>
                    </a>
                    <span class="badge text-bg-danger">{{ pse.quantity }}</span>
                </li>
            {% else %}
                <li class="list-group-item text-muted text-center">{{ 'All products in stock'|trans }}</li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}
</div>
