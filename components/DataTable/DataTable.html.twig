{# @var id string #}
{# @var columns list<\BackOfficeDefaultTwigBundle\UiComponents\DataTable\Column> #}
{# @var rows list<array<string, mixed>> #}
{% set sort_base_url = sortBaseUrl ?? app.request.pathInfo %}
{% set maxBp = datatable_max_breakpoint(columns) %}
{% set sortBp = datatable_sort_breakpoint(columns) %}
{% set colCount = columns|length + (maxBp ? 1 : 0) %}
<div class="card" data-testid="datatable-{{ id }}">
    {% if caption %}
        <div class="card-header bg-body-tertiary d-flex flex-wrap gap-2 justify-content-between align-items-center">
            <h2 class="h5 mb-0">{{ caption }}</h2>
            <div class="datatable-toolbar">
                {% block toolbar %}{% endblock %}
            </div>
        </div>
    {% endif %}

    {% if sortBp %}
        {# Mirrors the per-column <th> sort links below: below sortBp, a sortable column's <th> may
           be hidden (visibleFrom), taking its sort link down with it - this form is the only way
           left to change the sort. Lists every sortable column (not just the hidden ones) so the
           control's content stays stable across widths instead of changing on resize. A plain GET
           form (no JS navigation on change) so it works identically to the <th> links it replaces:
           other query params (filters, current sort) are carried as hidden inputs. #}
        <form method="get" action="{{ sort_base_url }}" class="bo-datatable__sort-fallback d-{{ sortBp }}-none p-2 border-bottom d-flex flex-wrap align-items-end gap-2" data-testid="datatable-{{ id }}-sort-fallback">
            {% for param, value in sortKeepParams %}
                {% if param != sortParam and param != sortDirectionParam and value is not null and value != '' %}
                    {% if value is iterable %}
                        {% for v in value %}
                            <input type="hidden" name="{{ param }}[]" value="{{ v }}">
                        {% endfor %}
                    {% else %}
                        <input type="hidden" name="{{ param }}" value="{{ value }}">
                    {% endif %}
                {% endif %}
            {% endfor %}
            <div>
                <label for="datatable-{{ id }}-sort-column" class="visually-hidden">{{ 'Sort by'|trans }}</label>
                <select id="datatable-{{ id }}-sort-column" name="{{ sortParam }}" class="form-select form-select-sm" data-testid="datatable-{{ id }}-sort-column">
                    {% for column in columns %}
                        {% if column.sortKey %}
                            <option value="{{ column.sortKey }}"{{ sortField == column.sortKey ? ' selected' : '' }}>{{ column.label }}</option>
                        {% endif %}
                    {% endfor %}
                </select>
            </div>
            <div>
                <label for="datatable-{{ id }}-sort-direction" class="visually-hidden">{{ 'Direction'|trans }}</label>
                <select id="datatable-{{ id }}-sort-direction" name="{{ sortDirectionParam }}" class="form-select form-select-sm" data-testid="datatable-{{ id }}-sort-direction">
                    <option value="asc"{{ sortDirection == 'asc' ? ' selected' : '' }}>{{ 'Ascending'|trans }}</option>
                    <option value="desc"{{ sortDirection == 'desc' ? ' selected' : '' }}>{{ 'Descending'|trans }}</option>
                </select>
            </div>
            <button type="submit" class="btn btn-outline-secondary btn-sm" data-testid="datatable-{{ id }}-sort-submit">{{ 'Sort'|trans }}</button>
        </form>
    {% endif %}

    <div class="table-responsive" role="region" tabindex="0"{% if caption %} aria-label="{{ caption }}"{% endif %}>
        <table class="table table-striped table-hover align-middle mb-0" data-testid="datatable-{{ id }}-table">
            <thead class="table-light">
                <tr>
                    {% if maxBp %}
                        <th scope="col" class="bo-datatable__details-col d-{{ maxBp }}-none">
                            <span class="visually-hidden">{{ 'Details'|trans }}</span>
                        </th>
                    {% endif %}
                    {% for column in columns %}
                        <th scope="col" class="text-{{ column.cellAlign }}{{ column.kind.value == 'actions' ? ' datatable-sticky-actions' : '' }}{{ column.responsiveClass() }}{{ column.visibleFrom != 'always' ? ' d-none d-' ~ column.visibleFrom ~ '-table-cell' : '' }}">
                            {%- if column.kind.value == 'select' -%}
                                <input type="checkbox" class="form-check-input"
                                       data-bo-bulk-select-target="all"
                                       data-action="change->bo-bulk-select#toggleAll"
                                       aria-label="{{ 'Select all'|trans }}"
                                       data-testid="datatable-{{ id }}-select-all">
                            {%- elseif column.sortKey -%}
                                {%- set isActive = sortField == column.sortKey -%}
                                {%- set nextDirection = isActive and sortDirection == 'asc' ? 'desc' : 'asc' -%}
                                {%- set sortParams = sortKeepParams|merge({ (sortParam): column.sortKey, (sortDirectionParam): nextDirection }) -%}
                                <a class="text-decoration-none text-reset d-inline-flex align-items-center gap-1"
                                   href="{{ sort_base_url }}?{{ sortParams|url_encode }}"
                                   data-testid="datatable-{{ id }}-sort-{{ column.sortKey }}">
                                    {{ column.label }}
                                    <i class="bi {{ isActive ? (sortDirection == 'asc' ? 'bi-sort-up' : 'bi-sort-down') : 'bi-arrow-down-up text-muted' }}" aria-hidden="true"></i>
                                </a>
                            {%- else -%}
                                {{ column.label }}
                            {%- endif -%}
                        </th>
                    {% endfor %}
                    {{ safe_hook(extraColumnsHeaderHook ?? ((hook ?: id) ~ '.table-header'), { table_id: id }|merge(headerHookContext)) }}
                </tr>
            </thead>
            <tbody{% for attr, value in tbodyAttributes %} {{ attr }}="{{ value }}"{% endfor %}>
                {% for row in rows %}
                    {% set detail_id = 'datatable-' ~ id ~ '-details-' ~ row.id|default(loop.index) %}
                    <tr data-testid="datatable-{{ id }}-row" data-row-id="{{ row.id|default('') }}"{% if row._row_class is defined and row._row_class %} class="{{ row._row_class }}"{% endif %}{% for attrName, attrValue in row._attrs|default({}) %} {{ attrName }}="{{ attrValue }}"{% endfor %}>
                        {% if maxBp %}
                            <td class="bo-datatable__details-col d-{{ maxBp }}-none">
                                <button type="button"
                                        class="btn btn-sm btn-link p-0 bo-datatable__details-toggle"
                                        data-controller="bo-datatable-details"
                                        data-action="click->bo-datatable-details#toggle"
                                        aria-expanded="false"
                                        aria-controls="{{ detail_id }}"
                                        aria-label="{{ 'View details for %identifier%'|trans({ '%identifier%': rowIdentifierKey ? row[rowIdentifierKey]|default('') : row.id|default('') }) }}"
                                        data-testid="datatable-{{ id }}-details-toggle">
                                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                </button>
                            </td>
                        {% endif %}
                        {% for column in columns %}
                            <td class="text-{{ column.cellAlign }}{{ column.kind.value == 'actions' ? ' datatable-sticky-actions' : '' }}{{ column.responsiveClass() }}{{ column.visibleFrom != 'always' ? ' d-none d-' ~ column.visibleFrom ~ '-table-cell' : '' }}" data-testid="datatable-{{ id }}-cell-{{ column.key }}">
                                {% include '@BackOfficeDefaultTwig/components/DataTable/cells/' ~ column.kind.value ~ '.html.twig' with {
                                    column: column,
                                    row: row,
                                    value: row[column.key]|default(null),
                                } only %}
                            </td>
                        {% endfor %}
                        {% set row_hook_context = { table_id: id, row: row, row_id: row.id|default(null) }|merge(rowHookContext) %}
                        {% for argName, rowKey in rowHookArgs %}
                            {% set row_hook_context = row_hook_context|merge({ (argName): row[rowKey]|default(null) }) %}
                        {% endfor %}
                        {{ safe_hook(extraColumnsHook ?? ((hook ?: id) ~ '.table-row'), row_hook_context) }}
                    </tr>
                    {% if maxBp %}
                        {#- d-{{ maxBp }}-none mirrors the toggle button/cell above: without it, a
                            row expanded below maxBp stays expanded (and unclosable, its toggle
                            being hidden) once the viewport grows past maxBp. -#}
                        <tr class="bo-datatable__details d-{{ maxBp }}-none" hidden id="{{ detail_id }}" data-testid="datatable-{{ id }}-details">
                            <td colspan="{{ colCount }}">
                                <dl class="bo-datatable__details-grid mb-0">
                                    {% for column in columns %}
                                        {#- A selection checkbox is never repeated: the bulk toolbar counts the
                                            checked boxes, and a second box per row would count every row twice. -#}
                                        {% if column.visibleFrom != 'always' and column.kind.value != 'select' %}
                                            <div class="bo-datatable__details-item d-{{ column.visibleFrom }}-none">
                                                <dt>{{ column.label }}</dt>
                                                <dd>
                                                    {# idSuffix keeps ids/data-testid unique: this cell is a second
                                                       rendering of the same column/row pair as the one above. #}
                                                    {% include '@BackOfficeDefaultTwig/components/DataTable/cells/' ~ column.kind.value ~ '.html.twig' with {
                                                        column: column,
                                                        row: row,
                                                        value: row[column.key]|default(null),
                                                        idSuffix: '-detail',
                                                    } only %}
                                                </dd>
                                            </div>
                                        {% endif %}
                                    {% endfor %}
                                </dl>
                            </td>
                        </tr>
                    {% endif %}
                {% else %}
                    <tr>
                        <td colspan="{{ colCount }}" class="text-center text-muted py-4" data-testid="datatable-{{ id }}-empty">
                            {{ emptyMessage|default('No data'|trans) }}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
