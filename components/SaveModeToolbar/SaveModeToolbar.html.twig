{#
    BoSaveModeToolbar - Save / Save and close / Close buttons, the inner-form-toolbar pattern.

    The two submit buttons post save_mode=stay (Save) and save_mode=close (Save and close); the
    controller redirects accordingly. Must be placed inside the form. No JavaScript needed.

    Props:
        closeUrl         when set, renders a Close link to this URL (default: none)
        closeLabel       close link label, |trans (default: Close)
        closeVariant     close link colour (default: outline-secondary)
        closeIcon        Close link icon (default: none)
        closeAttributes  extra attributes on the Close link, e.g. a Stimulus target (default: none)
        closeFirst       render the Close link before the submit buttons (default: true)
        saveModeField    name of the submit buttons (default: save_mode)
        saveLabel        Save button label, |trans (default: Save)
        saveCloseLabel   Save and close button label, |trans (default: Save and close)
        saveIcon         Save button icon (default: bi-check2)
        saveCloseIcon    Save and close button icon (default: bi-check2-all)
        saveVariant      Save button colour (default: outline-primary)
        saveCloseVariant Save and close button colour (default: primary)
        iconAfterLabel   render the icons after the labels (default: false)
        showSave         render the Save (stay) button (default: true)
        showSaveClose    render the Save and close button (default: true)
        align            start | center | end (default: end)
        wrapperClass     extra classes on the toolbar container (default: mt-3)
        testid           base data-testid: appends -cancel / -save-stay / -save-close (default: none)
#}
{% macro labelled(label, icon, iconAfterLabel) %}
    {%- if icon and not iconAfterLabel %}<i class="bi {{ icon }}" aria-hidden="true"></i> {% endif -%}
    {{ label|trans }}
    {%- if icon and iconAfterLabel %} <i class="bi {{ icon }}" aria-hidden="true"></i>{% endif -%}
{% endmacro %}
{% set close_link %}
    {% if closeUrl %}
        <a href="{{ closeUrl }}" class="btn btn-{{ closeVariant }}"{% for name, value in closeAttributes %} {{ name|e('html_attr') }}="{{ value }}"{% endfor %}{% if testid %} data-testid="{{ testid }}-cancel"{% endif %}>{{ _self.labelled(closeLabel, closeIcon, iconAfterLabel) }}</a>
    {% endif %}
{% endset %}
<div class="d-flex flex-wrap justify-content-{{ align }} gap-2{% if wrapperClass %} {{ wrapperClass }}{% endif %}">
    {% if closeFirst %}{{ close_link }}{% endif %}
    {% if showSave %}
        <button type="submit" name="{{ saveModeField }}" value="stay" class="btn btn-{{ saveVariant }}"{% if testid %} data-testid="{{ testid }}-save-stay"{% endif %}>
            {{ _self.labelled(saveLabel, saveIcon, iconAfterLabel) }}
        </button>
    {% endif %}
    {% if showSaveClose %}
        <button type="submit" name="{{ saveModeField }}" value="close" class="btn btn-{{ saveCloseVariant }}"{% if testid %} data-testid="{{ testid }}-save-close"{% endif %}>
            {{ _self.labelled(saveCloseLabel, saveCloseIcon, iconAfterLabel) }}
        </button>
    {% endif %}
    {% if not closeFirst %}{{ close_link }}{% endif %}
</div>
