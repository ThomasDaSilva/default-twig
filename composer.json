{
    "name": "thelia/backoffice-default-twig-template",
    "type": "thelia-backoffice-template",
    "description": "Thelia 3 back-office template based on Twig, Symfony UX and Bootstrap 5.",
    "license": "GPL-3.0-or-later",
    "keywords": [
        "thelia-backoffice-template",
        "thelia-twig",
        "thelia-bootstrap-5"
    ],
    "require": {
        "php": ">=8.3 <9.0",
        "thelia/core": "^3.1",
        "symfony/asset": "^7.4",
        "symfony/asset-mapper": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/twig-bundle": "^7.4",
        "symfony/ux-icons": "^2.21 || ^3.0",
        "symfony/ux-twig-component": "^2.19 || ^3.0",
        "symfonycasts/sass-bundle": "^0.10.0",
        "thelia/tiptap-module": "^1.0",
        "thelia/twig-engine-module": "^1.0.9",
        "twbs/bootstrap": "^5.3.8",
        "twbs/bootstrap-icons": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "BackOfficeDefaultTwigBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BackOfficeDefaultTwigBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "installer-name": "default-twig"
    }
}
