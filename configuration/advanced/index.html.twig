{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Advanced configuration'|trans }}{% endblock %}
{% block body_testid %}configuration-advanced{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Advanced configuration'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('advanced-configuration.top') }}

    <div class="container-fluid" data-testid="advanced-config-page">
        <h1 class="h3 mb-4">{{ 'Advanced configuration'|trans }}</h1>

        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5"><i class="bi bi-archive" aria-hidden="true"></i> {{ 'Application cache'|trans }}</h2>
                        <p class="text-muted small">{{ 'Clear Symfony cache (templates, container, routing).'|trans }}</p>
                    </div>
                    <div class="card-footer text-end">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#advanced-flush-cache-modal" data-testid="advanced-flush-cache">
                            <i class="bi bi-trash3" aria-hidden="true"></i> {{ 'Flush cache'|trans }}
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5"><i class="bi bi-file-earmark-binary" aria-hidden="true"></i> {{ 'Compiled assets'|trans }}</h2>
                        <p class="text-muted small">{{ 'Clear public/assets compiled output (Webpack/Encore artifacts).'|trans }}</p>
                    </div>
                    <div class="card-footer text-end">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#advanced-flush-assets-modal" data-testid="advanced-flush-assets">
                            <i class="bi bi-trash3" aria-hidden="true"></i> {{ 'Flush assets'|trans }}
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h2 class="h5"><i class="bi bi-images" aria-hidden="true"></i> {{ 'Images and documents'|trans }}</h2>
                        <p class="text-muted small">{{ 'Clear generated images and documents cache directories.'|trans }}</p>
                    </div>
                    <div class="card-footer text-end">
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#advanced-flush-images-modal" data-testid="advanced-flush-images">
                            <i class="bi bi-trash3" aria-hidden="true"></i> {{ 'Flush images/documents'|trans }}
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ component('BoConfirmDialog', {
        id: 'advanced-flush-cache-modal',
        title: 'Flush cache',
        formAction: path('admin.configuration.advanced.flush-cache'),
        message: 'Flush the application cache? The next pages load more slowly while it is rebuilt.',
        variant: 'warning',
        confirmLabel: 'Flush cache',
        confirmIcon: 'bi-trash3',
        testid: 'advanced-flush-cache',
    }) }}

    {{ component('BoConfirmDialog', {
        id: 'advanced-flush-assets-modal',
        title: 'Flush assets',
        formAction: path('admin.configuration.advanced.flush-assets'),
        message: 'Flush the compiled assets? The files under public/assets are deleted.',
        variant: 'warning',
        confirmLabel: 'Flush assets',
        confirmIcon: 'bi-trash3',
        testid: 'advanced-flush-assets',
    }) }}

    {{ component('BoConfirmDialog', {
        id: 'advanced-flush-images-modal',
        title: 'Flush images/documents',
        formAction: path('admin.configuration.advanced.flush-images-and-documents'),
        message: 'Flush the cached images and documents? The original files are kept.',
        variant: 'warning',
        confirmLabel: 'Flush images/documents',
        confirmIcon: 'bi-trash3',
        testid: 'advanced-flush-images',
    }) }}

    {{ safe_hook('advanced-configuration.bottom') }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('advanced-configuration.js', { location: 'advanced-configuration-js' }) }}
{% endblock %}
