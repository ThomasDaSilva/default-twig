{# @var active string #}
<ul class="nav nav-tabs mb-3" data-testid="ai-tabs">
    <li class="nav-item">
        <a class="nav-link{{ active == 'setup' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.setup.default') }}"{{ active == 'setup' ? ' aria-current="page"' : '' }} data-testid="ai-tab-setup">{{ 'Getting started'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'connections' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.default') }}"{{ active == 'connections' ? ' aria-current="page"' : '' }} data-testid="ai-tab-connections">{{ 'Connections'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'models' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.models.default') }}"{{ active == 'models' ? ' aria-current="page"' : '' }} data-testid="ai-tab-models">{{ 'Models'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'tiers' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.tiers.default') }}"{{ active == 'tiers' ? ' aria-current="page"' : '' }} data-testid="ai-tab-tiers">{{ 'Ranges'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'usages' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.usages.default') }}"{{ active == 'usages' ? ' aria-current="page"' : '' }} data-testid="ai-tab-usages">{{ 'Usages'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'register' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.register.default') }}"{{ active == 'register' ? ' aria-current="page"' : '' }} data-testid="ai-tab-register">{{ 'Register'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'consumption' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.consumption.default') }}"{{ active == 'consumption' ? ' aria-current="page"' : '' }} data-testid="ai-tab-consumption">{{ 'Consumption'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'tools' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.tools.default') }}"{{ active == 'tools' ? ' aria-current="page"' : '' }} data-testid="ai-tab-tools">{{ 'Tools'|trans }}</a>
    </li>
    <li class="nav-item">
        <a class="nav-link{{ active == 'approvals' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.approvals.default') }}"{{ active == 'approvals' ? ' aria-current="page"' : '' }} data-testid="ai-tab-approvals">{{ 'Approvals'|trans }}</a>
    </li>
    {% if is_granted('VIEW', 'admin.configuration.ai-mcp') %}
        <li class="nav-item">
            <a class="nav-link{{ active == 'tokens' ? ' active' : '' }}" href="{{ path('admin.configuration.ai.tokens.default') }}"{{ active == 'tokens' ? ' aria-current="page"' : '' }} data-testid="ai-tab-tokens">{{ 'MCP tokens'|trans }}</a>
        </li>
    {% endif %}
</ul>
{% if active != 'setup' %}
    {% set ai_pending = ai_setup_pending_count() %}
    {% if ai_pending > 0 %}
        <div class="alert alert-warning py-2 small" role="status" data-testid="ai-setup-notice">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            {% if ai_pending == 1 %}
                {{ 'The AI setup is not finished: 1 feature cannot work.'|trans }}
            {% else %}
                {{ 'The AI setup is not finished: %count% features cannot work.'|trans({ '%count%': ai_pending }) }}
            {% endif %}
            <a href="{{ path('admin.configuration.ai.setup.default') }}" class="alert-link">{{ 'See the getting started page'|trans }}</a>
        </div>
    {% endif %}
{% endif %}
