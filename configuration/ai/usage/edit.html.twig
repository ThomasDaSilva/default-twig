{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Artificial intelligence'|trans }} - {{ row.purpose }}{% endblock %}
{% block body_testid %}ai-usage-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.ai.default') }}">{{ 'Artificial intelligence'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.ai.usages.default') }}">{{ 'Usages'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ row.id }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {% set can_edit = is_granted('UPDATE', 'admin.configuration.ai') %}
    {% set problems = row.compliance_details|filter(detail => detail.state != 'met') %}
    <div class="container-fluid" data-testid="ai-usage-edit-page">
        <h1 class="h3 mb-1">{{ row.purpose }}</h1>
        <p class="text-body-secondary">{{ 'Module'|trans }} : {{ row.module }} · {{ 'Audience'|trans }} : {{ audience_label }} · {{ 'Range'|trans }} : {{ tier_label }}</p>

        {% if inactive_reason %}
            <div class="alert alert-secondary" role="status" data-testid="ai-usage-inactive">
                <strong>{{ 'This usage does not run.'|trans }}</strong> {{ inactive_reason }}
            </div>
        {% endif %}

        {% if row.compliance == 'not_met' %}
            <div class="alert alert-danger" role="alert" data-testid="ai-usage-not-compliant">
                <strong>{{ 'This usage does not respect Article 50 of the European AI regulation:'|trans }}</strong>
                <ul class="mb-1">
                    {% for detail in problems %}<li data-testid="ai-usage-reason">{{ detail.message }}</li>{% endfor %}
                </ul>
                <span class="small">{{ 'You can still save: Thelia explains the duty, it never forbids a choice. The responsibility stays with the shop.'|trans }}</span>
            </div>
        {% elseif row.compliance == 'to_review' %}
            <div class="alert alert-warning" role="status" data-testid="ai-usage-to-review">
                <ul class="mb-0">
                    {% for detail in problems %}<li>{{ detail.message }}</li>{% endfor %}
                </ul>
            </div>
        {% elseif row.compliance == 'met' %}
            <div class="alert alert-success" role="status" data-testid="ai-usage-compliant">{{ 'This usage respects Article 50 of the European AI regulation.'|trans }}</div>
        {% endif %}

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body">
                        <form method="post" action="{{ path('admin.configuration.ai.usages.save', { id: row.id }) }}" data-testid="ai-usage-form">
                            <input type="hidden" name="_token" value="{{ assignToken() }}">
                            <fieldset{{ can_edit ? '' : ' disabled' }}>
                                <input type="hidden" name="sections[]" value="general">
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" name="enabled" value="1" id="ai-usage-enabled"{{ switched_on ? ' checked' : '' }} data-testid="ai-usage-enabled">
                                    <label class="form-check-label" for="ai-usage-enabled">{{ 'Allow this usage'|trans }}</label>
                                    <div class="form-text">{{ 'Switch it off to stop this usage at once, without touching the module.'|trans }}</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="ai-usage-tier">{{ 'Range of this usage'|trans }}</label>
                                    <select class="form-select" id="ai-usage-tier" name="tier" data-testid="ai-usage-tier">
                                        <option value="">{{ 'As declared by the module (%range%)'|trans({ '%range%': declared_tier_label }) }}</option>
                                        {% for choice in tier_choices %}<option value="{{ choice.value }}"{{ choice.value == chosen_tier ? ' selected' : '' }}>{{ choice.label }}</option>{% endfor %}
                                    </select>
                                    <div class="form-text" data-testid="ai-usage-declared-tier">{{ 'Declared by the module: %range%.'|trans({ '%range%': declared_tier_label }) }} {{ 'The model of the range you pick must be able to do what the module needs (tools, structured answers, streaming), or the usage stops.'|trans }}</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="ai-usage-budget">{{ 'Monthly budget (US dollars)'|trans }}</label>
                                    <input type="text" class="form-control" id="ai-usage-budget" name="monthly_budget" inputmode="decimal" value="{{ budget }}" placeholder="10.00" data-testid="ai-usage-budget">
                                    <div class="form-text">{{ 'When the month has used this amount, the usage stops until the next month. A usage open to your visitors needs a budget to run. Leave empty for no cap.'|trans }}</div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label" for="ai-usage-model">{{ 'Model for this usage'|trans }}</label>
                                    <select class="form-select" id="ai-usage-model" name="pinned_model" data-testid="ai-usage-model">
                                        <option value="">{{ 'Follow the range (%range%)'|trans({ '%range%': tier_label }) }}</option>
                                        {% for group, models in model_choices %}
                                            <optgroup label="{{ group }}">
                                                {% for label, value in models %}<option value="{{ value }}"{{ value == pinned ? ' selected' : '' }}>{{ label }}</option>{% endfor %}
                                            </optgroup>
                                        {% endfor %}
                                    </select>
                                    <div class="form-text">{{ 'By default the usage runs on the model of its range (Ranges tab). Pick a model here only if this usage needs its own.'|trans }}</div>
                                </div>

                                <input type="hidden" name="sections[]" value="guardrails">
                                <h2 class="h6 mt-4" data-testid="ai-usage-section-guardrails">{{ 'Safety checks'|trans }}</h2>
                                <p class="form-text">{{ 'Optional checks run on what is sent to the model and on its answer. Block stops the request. Annotate lets it through and notes the problem in the log and in the response. Thelia always applies its own checks (limits, budget, untrusted content, output format) whatever you choose here.'|trans }}</p>
                                {% if guardrails is empty %}
                                    <p class="text-body-secondary" data-testid="ai-usage-no-guardrail">{{ 'No optional check is installed.'|trans }}</p>
                                {% endif %}
                                {% for guardrail in guardrails %}
                                    <div class="mb-3" data-testid="ai-usage-guardrail-{{ guardrail.name }}">
                                        <label class="form-label" for="ai-usage-guardrail-{{ guardrail.name }}">{{ guardrail.label }}</label>
                                        <select class="form-select" id="ai-usage-guardrail-{{ guardrail.name }}" name="guardrail[{{ guardrail.name }}]">
                                            <option value="follow"{{ guardrail.current == 'follow' ? ' selected' : '' }}>{{ 'Follow the module (%mode%)'|trans({ '%mode%': guardrail.declared_label }) }}</option>
                                            <option value="block"{{ guardrail.current == 'block' ? ' selected' : '' }}>{{ 'Block the request'|trans }}</option>
                                            <option value="annotate"{{ guardrail.current == 'annotate' ? ' selected' : '' }}>{{ 'Let it through and note it'|trans }}</option>
                                            <option value="off"{{ guardrail.current == 'off' ? ' selected' : '' }}>{{ 'Not applied'|trans }}</option>
                                        </select>
                                        <div class="form-text">{{ guardrail.help }}{% if not guardrail.installed %} <strong>{{ 'This check is not installed: when it is asked for, it counts as failed.'|trans }}</strong>{% endif %}</div>
                                    </div>
                                {% endfor %}
                                <p class="form-text">{{ 'Choosing "Follow the module" for every check gives back the checks the module declared.'|trans }}</p>

                                <input type="hidden" name="sections[]" value="limits">
                                <h2 class="h6 mt-4" data-testid="ai-usage-section-limits">{{ 'Limits'|trans }}</h2>
                                <p class="form-text">{{ 'An empty field means the default of Thelia, written under it.'|trans }}</p>
                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label" for="ai-usage-rpm">{{ 'Requests per minute'|trans }}</label>
                                        <input type="number" min="1" step="1" class="form-control" id="ai-usage-rpm" name="requests_per_minute" value="{{ limits.requests_per_minute }}" data-testid="ai-usage-rpm">
                                        <div class="form-text">{% if limits.default_requests_per_minute is null %}{{ 'Empty: no limit for this kind of usage.'|trans }}{% else %}{{ 'Empty: %count% per minute and per person.'|trans({ '%count%': limits.default_requests_per_minute }) }}{% endif %}</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="ai-usage-rpd">{{ 'Requests per day'|trans }}</label>
                                        <input type="number" min="1" step="1" class="form-control" id="ai-usage-rpd" name="requests_per_day" value="{{ limits.requests_per_day }}" data-testid="ai-usage-rpd">
                                        <div class="form-text">{% if limits.default_requests_per_day is null %}{{ 'Empty: no limit for this kind of usage.'|trans }}{% else %}{{ 'Empty: %count% per day and per person.'|trans({ '%count%': limits.default_requests_per_day }) }}{% endif %}</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="ai-usage-output">{{ 'Length of the answer (tokens)'|trans }}</label>
                                        <input type="number" min="1" step="1" class="form-control" id="ai-usage-output" name="max_output_tokens" value="{{ limits.max_output_tokens }}" data-testid="ai-usage-output">
                                        <div class="form-text">{{ 'Empty: %count% tokens, or less if the model cannot write that much.'|trans({ '%count%': limits.default_max_output_tokens }) }}</div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="ai-usage-input">{{ 'Length of what a person types (characters)'|trans }}</label>
                                        <input type="number" min="1" step="1" class="form-control" id="ai-usage-input" name="max_input_characters" value="{{ limits.max_input_characters }}" data-testid="ai-usage-input">
                                        <div class="form-text">{% if limits.default_max_input_characters is null %}{{ 'Empty: no limit.'|trans }}{% else %}{{ 'Empty: %count% characters, as the module declares.'|trans({ '%count%': limits.default_max_input_characters }) }}{% endif %}</div>
                                    </div>
                                </div>

                                <input type="hidden" name="sections[]" value="privacy">
                                <h2 class="h6 mt-4" data-testid="ai-usage-section-privacy">{{ 'Privacy'|trans }}</h2>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" name="store_prompt" value="1" id="ai-usage-store-prompt"{{ limits.store_prompt ? ' checked' : '' }} data-testid="ai-usage-store-prompt">
                                    <label class="form-check-label" for="ai-usage-store-prompt">{{ 'Keep the prompts in the log'|trans }}</label>
                                    <div class="form-text">{{ 'Off by default: the log keeps the cost, the model and the checks, not the text sent. Turn it on only to investigate; the texts can hold personal data.'|trans }}</div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label" for="ai-usage-retention">{{ 'Days the prompts are kept'|trans }}</label>
                                    <input type="number" min="1" step="1" class="form-control" id="ai-usage-retention" name="prompt_retention_days" value="{{ limits.prompt_retention_days }}" data-testid="ai-usage-retention">
                                    <div class="form-text">{{ 'Empty: %count% days. Only used when the prompts are kept.'|trans({ '%count%': limits.default_prompt_retention_days }) }}</div>
                                </div>

                                <h2 class="h6 mt-4">{{ 'Transparency (Article 50)'|trans }}</h2>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" name="notice" value="1" id="ai-usage-notice"{{ row.notice_enabled ? ' checked' : '' }} data-testid="ai-usage-notice">
                                    <label class="form-check-label" for="ai-usage-notice">{{ 'Tell people they are talking to an AI'|trans }}</label>
                                    <div class="form-text">{{ 'Article 50(1): when a person talks with an AI, they must be told. Thelia shows a short notice on the feature.'|trans }}</div>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" role="switch" name="mark" value="1" id="ai-usage-mark"{{ row.provenance_mark_enabled ? ' checked' : '' }} data-testid="ai-usage-mark">
                                    <label class="form-check-label" for="ai-usage-mark">{{ 'Mark generated content as made by an AI'|trans }}</label>
                                    <div class="form-text">{{ 'Article 50(2): text, images or sound produced by an AI must be marked as such, in a way machines can read. Thelia adds the mark to what the feature generates.'|trans }}</div>
                                </div>
                            </fieldset>
                            <div class="d-flex justify-content-end gap-2">
                                <a href="{{ path('admin.configuration.ai.usages.default') }}" class="btn btn-outline-secondary">{{ 'Cancel'|trans }}</a>
                                {% if can_edit %}
                                    <button type="submit" class="btn btn-primary" data-testid="ai-usage-save"><i class="bi bi-check2"></i> {{ 'Save'|trans }}</button>
                                {% endif %}
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h2 class="h6">{{ 'About the budget'|trans }}</h2>
                        <p class="text-body-secondary small mb-0">{{ 'Amounts are in US dollars, as the AI companies bill them. Your shop pays the provider directly.'|trans }}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
