{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Artificial intelligence'|trans }} - {{ 'Usages'|trans }}{% endblock %}
{% block body_testid %}ai-usages{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.ai.default') }}">{{ 'Artificial intelligence'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Usages'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="ai-usages-page">
        <h1 class="h3 mb-3">{{ 'Artificial intelligence'|trans }}</h1>

        {% include '@BackOfficeDefaultTwig/configuration/ai/_tabs.html.twig' with { active: 'usages' } only %}

        <p class="text-body-secondary">{{ 'A usage is one thing a module asks the AI to do, for example answering your visitors. Each usage can be switched on or off, capped, and checked against the duties of the European AI regulation (Article 50).'|trans }}</p>

        {% if rows|filter(row => row.trifecta == 'yes') %}
            <div class="alert alert-danger" role="alert" data-testid="ai-usages-trifecta">{{ 'Warning: at least one usage can be offered tools that together read private data, read untrusted content and reach out of the shop. An attack hidden in a text the AI reads could use them. This is signalled, not blocked: review the tools of that usage.'|trans }}</div>
        {% endif %}

        {{ component('BoDataTable', {
            id: 'ai-usages',
            columns: [
                column_text('usage', 'Usage'|trans, 'start', wrap: true),
                column('module', 'Module'|trans, 'start', hideBelow: 'md'),
                column_text('audience', 'Audience'|trans, 'start', hideBelow: 'md', wrap: true),
                column_text('tier', 'Range'|trans, 'start', hideBelow: 'lg', wrap: true),
                column_badge('trifecta', 'Tools together'|trans, { yes: 'danger', no: 'secondary' }, 'start', 'trifecta_label', hideBelow: 'lg'),
                column_text('budget', 'Monthly budget'|trans, 'start', hideBelow: 'md', wrap: true),
                column_badge('status', 'Status'|trans, { active: 'success', inactive: 'secondary' }, 'start', 'status_label'),
                column_badge('compliance', 'Article 50'|trans, { met: 'success', not_met: 'danger', to_review: 'warning', not_applicable: 'secondary' }, 'start', 'compliance_label', hideBelow: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No module declares an AI usage yet.'|trans,
        }) }}
    </div>
{% endblock %}
