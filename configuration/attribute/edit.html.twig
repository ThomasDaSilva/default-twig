{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit attribute'|trans }} - {{ attribute.title }}{% endblock %}
{% block body_testid %}configuration-attribute-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.attributes.default') }}">{{ 'Attributes'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ attribute.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('attribute-edit.top', { attribute_id: attribute.id }) }}

    <div class="container-fluid" data-testid="attribute-edit-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Attribute'|trans }} <small class="text-muted">#{{ attribute.id }}</small></h1>
            <div class="d-flex flex-wrap gap-2">
                <a href="{{ path('admin.configuration.attributes.add-to-all', { attribute_id: attribute.id }) }}" data-bo-post class="btn btn-outline-secondary" data-testid="attribute-add-to-all">
                    <i class="bi bi-plus-square" aria-hidden="true"></i> {{ 'Add to all templates'|trans }}
                </a>
                <a href="{{ path('admin.configuration.attributes.rem-from-all', { attribute_id: attribute.id }) }}" data-bo-post class="btn btn-outline-secondary" data-testid="attribute-rem-from-all">
                    <i class="bi bi-x-square" aria-hidden="true"></i> {{ 'Remove from all templates'|trans }}
                </a>
                <a href="{{ path('admin.configuration.attributes.default') }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left" aria-hidden="true"></i> {{ 'Back to list'|trans }}
                </a>
            </div>
        </div>

        <div class="mb-3">
            {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
        </div>

        <div class="row">
            <div class="col-md-7">
                <div class="card">
                    <div class="card-header">{{ 'General'|trans }}</div>
                    <div class="card-body">
                        {% form_theme form with bo_form_themes only %}
                        {{ form_start(form, { action: path('admin.configuration.attributes.save', { attribute_id: attribute.id }), method: 'post', attr: { 'data-testid': 'attribute-edit-form' } }) }}
                            <input type="hidden" name="attribute_id" value="{{ attribute.id }}">
                            <div class="mb-3">
                                {{ form_label(form.title) }}
                                {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                                {{ form_errors(form.title) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.chapo) }}
                                {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description, { attr: { class: 'form-control', rows: 6 } }) }}
                            </div>
                            <div class="mb-3">
                                {{ form_label(form.postscriptum) }}
                                {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 3 } }) }}
                            </div>
                            {{ form_widget(form.id) }}
                            {{ form_widget(form.locale) }}
                            {{ safe_hook('attribute.update-form', { attribute: attribute.id }) }}
                            {{ component('BoSaveModeToolbar', {
                                closeUrl: path('admin.configuration.attributes.default'),
                                wrapperClass: '',
                                testid: 'attribute-edit',
                            }) }}
                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            <div class="col-md-5">
                <div class="card">
                    <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center">
                        <span>{{ 'Values'|trans }}</span>
                        <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#attribute-av-create-modal" data-testid="attributeav-create-button">
                            <i class="bi bi-plus" aria-hidden="true"></i> {{ 'Add'|trans }}
                        </button>
                    </div>
                    <div class="table-responsive">
                    <table class="table mb-0" data-testid="attributeav-table">
                        <thead>
                            <tr>
                                <th class="bo-sortable-grip"><span class="visually-hidden">{{ 'Drag to reorder'|trans }}</span></th>
                                <th>{{ 'Title'|trans }}</th>
                                <th class="text-center">{{ 'Position'|trans }}</th>
                                <th class="text-end">{{ 'Actions'|trans }}</th>
                                {{ safe_hook('attributes-value.table-header', { attribute_id: attribute.id, location: 'attributes_value_table_header' }) }}
                            </tr>
                        </thead>
                        <tbody data-controller="bo-sortable"
                               data-bo-sortable-url-value="{{ av_position_url }}"
                               data-bo-sortable-token-value="{{ av_position_token }}"
                               data-bo-sortable-param-name-value="attributeav_id">
                            {% for av in attribute_avs %}
                                <tr data-row-id="{{ av.id }}" data-testid="attributeav-row-{{ av.id }}">
                                    <td class="bo-sortable-grip" data-bo-sortable-handle title="{{ 'Drag to reorder'|trans }}" data-testid="attributeav-handle-{{ av.id }}">
                                        <i class="bi bi-grip-vertical" aria-hidden="true"></i>
                                    </td>
                                    <td>
                                        <input type="text"
                                               class="form-control form-control-sm"
                                               value="{{ av.title }}"
                                               data-controller="bo-inline-edit"
                                               data-bo-inline-edit-url-value="{{ av.update_title_url }}"
                                               data-bo-inline-edit-token-value="{{ assignToken() }}"
                                               data-bo-inline-edit-original-value="{{ av.title }}"
                                               data-action="blur->bo-inline-edit#submit keydown.enter->bo-inline-edit#submitFromEnter"
                                               data-testid="attributeav-title-{{ av.id }}"
                                               aria-label="{{ 'Edit attribute value title'|trans }}">
                                    </td>
                                    <td class="text-center">{{ av.position }}</td>
                                    <td class="text-end">
                                        <a href="{{ av.delete_url }}" data-bo-post class="btn btn-sm btn-outline-danger" data-testid="attributeav-delete-{{ av.id }}" onclick="return confirm('{{ 'Delete this value?'|trans }}')">
                                            <i class="bi bi-trash" aria-hidden="true"></i>
                                        </a>
                                    </td>
                                    {{ safe_hook('attributes-value.table-row', { attribute_id: attribute.id, attribute_av_id: av.id, location: 'attributes_value_table_row' }) }}
                                </tr>
                            {% else %}
                                <tr><td colspan="4" class="text-muted text-center">{{ 'No value yet.'|trans }}</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ safe_hook('attribute-edit.bottom', { attribute_id: attribute.id }) }}

    <div class="modal fade" id="attribute-av-create-modal" tabindex="-1" aria-labelledby="attribute-av-create-modal-title" aria-hidden="true">
        <div class="modal-dialog modal-dialog-scrollable">
            <div class="modal-content">
                {% form_theme av_create_form with bo_form_themes only %}
                {{ form_start(av_create_form, { action: path('admin.configuration.attributes-av.create'), method: 'post', attr: { 'data-testid': 'attributeav-create-form' } }) }}
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="attribute-av-create-modal-title">{{ 'Add a attribute value'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            {{ form_label(av_create_form.title) }}
                            {{ form_widget(av_create_form.title, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(av_create_form.title) }}
                        </div>
                        {{ form_widget(av_create_form.locale) }}
                        {{ form_widget(av_create_form.attribute_id) }}
                        {{ safe_hook('attribute-value.create-form', { location: 'attribute_value_create_form' }) }}
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Cancel'|trans }}</button>
                        <button type="submit" class="btn btn-primary" data-testid="attributeav-create-submit">{{ 'Add'|trans }}</button>
                    </div>
                {{ form_end(av_create_form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('attribute.edit-js', { attribute_id: attribute.id, location: 'attribute-edit-js' }) }}
    {{ safe_hook('wysiwyg.js', { location: 'attribute-edit-js' }) }}
{% endblock %}
