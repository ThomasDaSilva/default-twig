{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit order status'|trans }} - {{ status.title }}{% endblock %}
{% block body_testid %}configuration-order-status-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.order-status.default') }}">{{ 'Order statuses'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ status.title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('order-status-edit.top', { order_status_id: status.id }) }}

    {% set extra_tabs = hook_block('order-status.tab', { order_status: status.id, id: status.id }) %}

    <div class="container-fluid" data-testid="order-status-edit-page">
        <h1 class="h3 mb-3">{{ 'Order status'|trans }} <small class="text-muted">#{{ status.id }}</small></h1>

        <div class="bo-tab-bar">
            <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('general') == 'general' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-general" type="button" data-testid="order-status-tab-general">
                    {{ 'General'|trans }}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('general') == 'transitions' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-transitions" type="button" data-testid="order-status-tab-transitions">
                    {{ 'Transitions'|trans }}
                    {% if not transitions_free %}<span class="badge text-bg-secondary ms-1">{{ transition_targets|filter(t => t.checked)|length }}</span>{% endif %}
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('general') == 'actions' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-actions" type="button" data-testid="order-status-tab-actions">
                    {{ 'Actions'|trans }}
                    {% if action_rows|length > 0 %}<span class="badge text-bg-secondary ms-1">{{ action_rows|length }}</span>{% endif %}
                </button>
            </li>
            {% for block in extra_tabs %}
                <li class="nav-item" role="presentation">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#{{ block.id }}"
                            {% if block.href is defined and block.href %}data-href="{{ block.href }}"{% endif %}
                            type="button" data-testid="order-status-tab-{{ block.id }}">{{ block.title }}</button>
                </li>
            {% endfor %}
            <li class="nav-item" role="presentation">
                <button class="nav-link {% if current_tab|default('') == 'modules' %}active{% endif %}" data-bs-toggle="tab" data-bs-target="#tab-modules" type="button" data-testid="order-status-tab-modules">
                    {{ 'Modules'|trans }}
                </button>
            </li>
        </ul>
            <div class="bo-tab-bar__aside">
                {{ component('BoLanguageSwitcher', { currentLanguageId: edit_language_id }) }}
            </div>
        </div>

        <div class="tab-content">
            <div class="tab-pane fade {% if current_tab|default('general') == 'general' %}show active{% endif %}" id="tab-general" role="tabpanel">
                {% form_theme form with bo_form_themes only %}
                {{ form_start(form, { action: path('admin.order-status.save', { order_status_id: status.id }), method: 'post', attr: { 'data-testid': 'order-status-edit-form' } }) }}
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.title) }}
                            {{ form_widget(form.title, { attr: { class: 'form-control' } }) }}
                        </div>
                        <div class="col-md-4 mb-3">
                            {{ form_label(form.code) }}
                            {{ form_widget(form.code, { attr: { class: 'form-control' } }) }}
                        </div>
                        <div class="col-md-2 mb-3">
                            {{ form_label(form.color) }}
                            {{ form_widget(form.color, { attr: { class: 'form-control', type: 'color' } }) }}
                        </div>
                    </div>
                    {% if form.equivalent_code is defined %}
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                {{ form_label(form.equivalent_code) }}
                                {{ form_widget(form.equivalent_code, { attr: { class: 'form-select' } }) }}
                                <div class="form-text">{{ 'Orders in this status are handled as if they had the selected status.'|trans }}</div>
                            </div>
                        </div>
                    {% endif %}
                    <div class="mb-3">
                        {{ form_label(form.chapo) }}
                        {{ form_widget(form.chapo, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.description) }}
                        {{ form_widget(form.description, { attr: { class: 'form-control', rows: 6 } }) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.postscriptum) }}
                        {{ form_widget(form.postscriptum, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>
                    {{ form_widget(form.id) }}
                    {{ form_widget(form.locale) }}
                    {{ safe_hook('order-status.update-form', { order_status: status.id }) }}
                    <button type="submit" class="btn btn-primary" data-testid="order-status-edit-submit">{{ 'Save'|trans }}</button>
                    <a href="{{ path('admin.order-status.default') }}" class="btn btn-outline-secondary">{{ 'Back'|trans }}</a>
                {{ form_end(form) }}
            </div>

            <div class="tab-pane fade {% if current_tab|default('general') == 'transitions' %}show active{% endif %}" id="tab-transitions" role="tabpanel" data-testid="order-status-transitions-pane">
                {% include '@BackOfficeDefaultTwig/configuration/order-status/_transitions_tab.html.twig' %}
            </div>

            <div class="tab-pane fade {% if current_tab|default('general') == 'actions' %}show active{% endif %}" id="tab-actions" role="tabpanel" data-testid="order-status-actions-pane">
                {% include '@BackOfficeDefaultTwig/configuration/order-status/_actions_tab.html.twig' %}
            </div>

            {% for block in extra_tabs %}
                <div class="tab-pane fade" id="{{ block.id }}" role="tabpanel">
                    {% if block.href is defined and block.href %}
                        <div class="text-center"><span class="loading">{{ 'Please wait, loading'|trans }}</span></div>
                    {% else %}
                        {{ block.content|raw }}
                    {% endif %}
                </div>
            {% endfor %}

            <div class="tab-pane fade {% if current_tab|default('') == 'modules' %}show active{% endif %}" id="tab-modules" role="tabpanel">
                {{ safe_hook('order-status.tab-content', { order_status: status.id, order_status_id: status.id, location: 'order-status-edit', view: 'order-status' }) }}
            </div>
        </div>
    </div>

    {{ safe_hook('order-status-edit.bottom', { order_status_id: status.id }) }}

    {% if is_granted('UPDATE', 'admin.configuration.order-status') %}
        {{ component('BoConfirmDialog', {
            id: 'order-status-action-delete-modal',
            title: 'Remove this action',
            formAction: path('admin.order-status.actions.delete'),
            message: 'Do you really want to remove this action? The status change itself is not affected.',
            testid: 'order-status-action-delete',
            prefillTrigger: 'data-action-id',
            prefillInput: 'action_id',
        }) }}
    {% endif %}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('order-status.edit-js', { order_status_id: status.id }) }}
    {{ safe_hook('wysiwyg.js') }}
{% endblock %}
