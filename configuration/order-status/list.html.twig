{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Order statuses'|trans }}{% endblock %}
{% block body_testid %}configuration-order-statuses{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.configuration.index') }}">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Order statuses'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('order-status.top') }}

    <div class="container-fluid" data-testid="order-statuses-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Order statuses management'|trans }}</h1>
            {% if is_granted('CREATE', 'admin.configuration.order-status') %}
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#order-status-create-modal" data-testid="order-status-create-button">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a new order status'|trans }}
                </button>
            {% endif %}
        </div>

        {% if unreachable_statuses|length > 0 %}
            <div class="alert alert-warning d-flex align-items-start gap-2" role="alert" data-testid="order-status-unreachable-warning">
                <i class="bi bi-exclamation-triangle-fill mt-1" aria-hidden="true"></i>
                <div>
                    <strong>{{ 'No transition leads to: %statuses%'|trans({ '%statuses%': unreachable_statuses|join(', ') }) }}</strong>
                    <div class="small">{{ 'Orders can never reach these statuses through the allowed transitions. Add a transition to them, or leave one status free.'|trans }}</div>
                </div>
            </div>
        {% endif %}

        {{ component('BoDataTable', {
            id: 'order-statuses',
            columns: [
                column('id', 'ID'|trans, 'start', 'id', hideBelow: 'md'),
                column('title', 'Title'|trans, 'start', 'title'),
                column('code', 'Code'|trans, 'start', 'code', hideBelow: 'lg'),
                column_html('color_html', 'Color'|trans, 'center'),
                column_html('orders_html', 'Orders'|trans, 'center', hideBelow: 'lg'),
                column('position', 'Position'|trans, 'center', 'position', hideBelow: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No order status yet.'|trans,
            extraColumnsHeaderHook: 'order-status.table-header',
            extraColumnsHook: 'order-status.table-row',
            rowHookArgs: { order_status_id: 'id' },
            sortField: sort_field,
            sortDirection: sort_direction,
            tbodyAttributes: {
                'data-controller': 'bo-sortable',
                'data-bo-sortable-url-value': update_position_url,
                'data-bo-sortable-token-value': update_position_token,
                'data-bo-sortable-param-name-value': 'order_status_id',
            },
        }) }}
    </div>


    {{ safe_hook('order-status.bottom') }}

    {% component 'BoCreateDialog' with {
        id: 'order-status-create-modal',
        title: 'Create a new order status',
        form: create_form,
        formAction: path('admin.order-status.create'),
        submitLabel: 'Create',
        testid: 'order-status-create',
        size: '',
    } %}
        {% block fields %}
            <div class="mb-3">
                {{ form_label(create_form.title) }}
                {{ form_widget(create_form.title, { attr: { class: 'form-control' } }) }}
            </div>
            <div class="mb-3">
                {{ form_label(create_form.code) }}
                {{ form_widget(create_form.code, { attr: { class: 'form-control' } }) }}
            </div>
            <div class="mb-3">
                {{ form_label(create_form.equivalent_code) }}
                {{ form_widget(create_form.equivalent_code, { attr: { class: 'form-select' } }) }}
                <div class="form-text">{{ 'Orders in this status are handled as if they had the selected status.'|trans }}</div>
            </div>
            <div class="mb-3">
                {{ form_label(create_form.color) }}
                {{ form_widget(create_form.color, { attr: { class: 'form-control', type: 'color' } }) }}
            </div>
            {{ form_widget(create_form.locale) }}
        {% endblock %}
    {% endcomponent %}

    {{ component('BoConfirmDialog', {
        id: 'order-status-delete-modal',
        title: 'Delete order status',
        formAction: path('admin.order-status.delete'),
        message: 'Do you really want to delete this order status?',
        testid: 'order-status-delete',
        prefillTrigger: 'data-order-status-id',
        prefillInput: 'order_status_id',
    }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('order-status.js', { location: 'order-status-js' }) }}
{% endblock %}
