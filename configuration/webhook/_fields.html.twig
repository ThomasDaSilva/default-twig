{% set domain_labels = { order: 'Orders'|trans, customer: 'Customers'|trans, product: 'Products'|trans } %}
{% set domains = {} %}
{% for child in form.events %}
    {% set domain = child.vars.value|split('.')|first %}
    {% set domains = domains|merge({ (domain): (domains[domain] ?? [])|merge([child]) }) %}
{% endfor %}

{{ form_row(form.title) }}
{{ form_row(form.url) }}

<fieldset class="mb-3" data-testid="webhook-events">
    <legend class="form-label fs-6">{{ 'Events'|trans }}</legend>
    {{ form_errors(form.events) }}
    {% for domain, children in domains %}
        <div class="mb-2">
            <div class="fw-semibold">{{ domain_labels[domain] ?? domain|capitalize }}</div>
            {% for child in children %}
                <div class="form-check">
                    {{ form_widget(child, { attr: { class: 'form-check-input' } }) }}
                    {{ form_label(child, null, { label_attr: { class: 'form-check-label' }, translation_domain: false }) }}
                </div>
            {% endfor %}
        </div>
    {% endfor %}
</fieldset>

{{ form_row(form.payload_mode) }}
{{ form_row(form.status) }}
