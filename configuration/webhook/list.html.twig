{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Webhooks'|trans }}{% endblock %}
{% block body_testid %}webhooks-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="/admin/configuration">{{ 'Configuration'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Webhooks'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="webhooks-page">
        <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-3">
            <h1 class="h3 mb-0">{{ 'Webhooks'|trans }}</h1>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('admin.configuration.webhooks.deliveries') }}" data-testid="webhook-journal-link">
                    <i class="bi bi-list-ul" aria-hidden="true"></i> {{ 'Delivery log'|trans }}
                </a>
                {% if is_granted('CREATE', 'admin.configuration.webhook') %}
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#webhook-create-modal" data-testid="webhook-create-button">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> {{ 'Add a subscription'|trans }}
                    </button>
                {% endif %}
            </div>
        </div>

        {% if runs_inline %}
            <div class="alert alert-warning" role="alert" data-testid="webhook-inline-banner">
                <strong>{{ 'No message queue is configured.'|trans }}</strong>
                {{ 'Each request is sent while the action that raised the event is being saved, a slow receiver slows that action down by up to 10 seconds, and a failed request is not sent again.'|trans }}
            </div>
        {% endif %}

        {{ component('BoDataTable', {
            id: 'webhooks',
            columns: [
                column('id', 'ID'|trans, 'start', 'id', hideBelow: 'md'),
                column('title', 'Title'|trans, 'start', 'title'),
                column('url', 'Receiver'|trans, 'start', hideBelow: 'md'),
                column_html('events', 'Events'|trans, 'start', hideBelow: 'xl'),
                column_badge('status', 'Status'|trans, { active: 'success', inactive: 'secondary', error: 'danger' }, 'start', 'status_label', sortKey: 'status'),
                column_html('failure', 'Failure'|trans, 'start', hideBelow: 'lg'),
                column('last_success', 'Last successful delivery'|trans, 'start', hideBelow: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ],
            rows: rows,
            emptyMessage: 'No webhook subscription defined.'|trans,
            sortField: sort_field,
            sortDirection: sort_direction,
        }) }}
    </div>

    {% if is_granted('CREATE', 'admin.configuration.webhook') %}
        {% component 'BoCreateDialog' with {
            id: 'webhook-create-modal',
            title: 'New webhook subscription',
            form: create_form,
            formAction: path('admin.configuration.webhooks.create'),
            submitLabel: 'Create',
            testid: 'webhook-create',
            fieldsTemplate: '@BackOfficeDefaultTwig/configuration/webhook/_fields.html.twig',
        } %}
        {% endcomponent %}
    {% endif %}

    {% include '@BackOfficeDefaultTwig/configuration/webhook/_delete_modal.html.twig' %}
{% endblock %}
