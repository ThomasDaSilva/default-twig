{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Edit address'|trans }}{% endblock %}
{% block body_testid %}customer-address-edit{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.customers') }}">{{ 'Customers'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.customer.update.view', { customer_id: address.customerId }) }}">{{ 'Customer'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ address.label }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="address-edit-page">
        <h1 class="h3 mb-3">{{ 'Edit address'|trans }}: <span class="text-muted">{{ address.label }}</span></h1>

        <div class="card">
            <div class="card-body">
                {% form_theme form with bo_form_themes only %}
                {{ form_start(form, {
                    action: path('admin.address.save'),
                    method: 'post',
                    attr: { 'data-testid': 'address-edit-form' },
                }) }}
                    {{ form_widget(form.id) }}
                    {{ form_widget(form.customer_id) }}
                    <div class="row g-3">
                        <div class="col-md-12">{{ form_row(form.label) }}</div>
                        <div class="col-md-3">{{ form_row(form.title) }}</div>
                        <div class="col-md-4">{{ form_row(form.firstname) }}</div>
                        <div class="col-md-5">{{ form_row(form.lastname) }}</div>
                        <div class="col-md-12">{{ form_row(form.company) }}</div>
                        {% if form.siret is defined %}
                            <div class="col-md-6">{{ form_row(form.siret) }}</div>
                        {% endif %}
                        {% if form.vat_number is defined %}
                            <div class="col-md-6">{{ form_row(form.vat_number) }}</div>
                        {% endif %}
                        {% if address is defined and address and address.vatVerifiedAt %}
                            <div class="col-12" data-testid="address-vat-verification">
                                <div class="alert {{ address.vatVerificationValid ? 'alert-success' : 'alert-secondary' }} mb-0">
                                    {% if address.vatVerificationValid %}
                                        {{ 'VAT number verified on %date%'|trans({'%date%': address.vatVerifiedAt|format_date}) }}
                                    {% else %}
                                        {{ 'VAT number last verified on %date%, outside the validity period: this address no longer exempts.'|trans({'%date%': address.vatVerifiedAt|format_date}) }}
                                    {% endif %}
                                    {% if address.vatVerifiedName %}<span class="text-muted">({{ address.vatVerifiedName }})</span>{% endif %}
                                </div>
                            </div>
                        {% endif %}
                        {% if vat_verification_available|default(false) and address is defined and address and address.vatNumber %}
                            <div class="col-12">
                                <button type="submit" class="btn btn-outline-secondary btn-sm"
                                        form="address-vat-verify-form"
                                        data-testid="address-vat-verify-submit">
                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> {{ 'Verify the VAT number again'|trans }}
                                </button>
                            </div>
                        {% endif %}
                        {# A warning and not a block: an address saved before these columns
                           existed is legitimate, and only a submit has to be complete. #}
                        {% if form.company.vars.value|default('')|trim is not empty
                            and form.siret is defined and form.vat_number is defined
                            and (form.siret.vars.value|default('')|trim is empty
                                 or form.vat_number.vars.value|default('')|trim is empty) %}
                            <div class="col-12">
                                <div class="alert alert-warning mb-0" data-testid="address-legal-identifiers-incomplete">
                                    {{ 'This address has a company name but is missing a registration number or a VAT number. An invoice for a business buyer requires both.'|trans }}
                                </div>
                            </div>
                        {% endif %}
                        <div class="col-md-12">{{ form_row(form.address1) }}</div>
                        <div class="col-md-6">{{ form_row(form.address2) }}</div>
                        <div class="col-md-6">{{ form_row(form.address3) }}</div>
                        <div class="col-md-6">{{ form_row(form.zipcode) }}</div>
                        <div class="col-md-6">{{ form_row(form.city) }}</div>
                        <div class="col-12" data-controller="bo-state-cascade">
                            <div class="row g-3">
                                <div class="col-md-6">{{ form_row(form.country) }}</div>
                                <div class="col-md-6" data-bo-state-cascade-target="wrapper">{{ form_row(form.state) }}</div>
                            </div>
                        </div>
                        <div class="col-md-6">{{ form_row(form.phone) }}</div>
                        <div class="col-md-6">{{ form_row(form.cellphone) }}</div>
                    </div>
                    {{ safe_hook('customer.address-update-form', { customer_id: address.customerId, location: 'customer_address_update_form' }) }}
                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a href="{{ path('admin.customer.update.view', { customer_id: address.customerId }) }}" class="btn btn-outline-secondary" data-testid="address-edit-cancel">
                            {{ 'Cancel'|trans }}
                        </a>
                        <button type="submit" class="btn btn-primary" data-testid="address-edit-submit">
                            <i class="bi bi-check2" aria-hidden="true"></i> {{ 'Save'|trans }}
                        </button>
                    </div>
                {{ form_end(form) }}
                {% if vat_verification_available|default(false) and address is defined and address and address.vatNumber %}
                    <form id="address-vat-verify-form" method="post" action="{{ path('admin.address.vat.verify') }}" data-testid="address-vat-verify-form">
                        <input type="hidden" name="address_id" value="{{ address.id }}">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                    </form>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
