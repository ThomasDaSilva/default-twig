{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Customers'|trans }}{% endblock %}
{% block body_testid %}customers-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Customers'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('customer.top') }}

    <div class="container-fluid" data-testid="customers-page">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Customers'|trans } %}
            {% block title %}
                {{ 'Customers'|trans }} <span class="badge bg-secondary" data-testid="customers-count">{{ total }}</span>
            {% endblock %}
            {% block actions %}
                <div class="d-flex flex-wrap align-items-center gap-2" data-testid="customer-quick-filters">
                    {% for chip in filters.quick_chips %}
                        <a class="btn btn-sm {{ chip.active ? 'btn-primary' : 'btn-outline-secondary' }}"
                           href="{{ chip.url }}"
                           data-testid="customer-quick-filter-{{ chip.code }}">
                            <i class="bi {{ chip.icon }} me-1" aria-hidden="true"></i>{{ chip.label }}
                        </a>
                    {% endfor %}
                </div>
                {% if is_granted('CREATE', 'admin.customer') %}
                    <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#customer-create-modal" data-testid="customer-create-button">
                        <i class="bi bi-plus-lg me-1" aria-hidden="true"></i>{{ 'Add a new customer'|trans }}
                    </button>
                {% endif %}
            {% endblock %}
        {% endembed %}

        <form method="get" action="{{ path('admin.customers') }}" class="bo-customer-filters" data-testid="customer-search-form">
            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label" for="customer-search-q">{{ 'Search'|trans }}</label>
                    <input type="search" id="customer-search-q" name="q" value="{{ filters.search_input }}"
                           class="form-control"
                           placeholder="{{ 'Reference, name or email'|trans }}"
                           data-testid="customer-search-input">
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-testid="customer-search-submit">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ 'Apply'|trans }}
                    </button>
                    <a href="{{ filters.clear_all_url }}" class="btn btn-outline-secondary" data-testid="customer-reset">{{ 'Reset'|trans }}</a>
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-link p-0 bo-customer-filters__toggle" data-bs-toggle="collapse"
                        data-bs-target="#bo-customer-advanced" aria-controls="bo-customer-advanced"
                        aria-expanded="false"
                        data-testid="customer-advanced-toggle">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                    <span class="bo-customer-filters__toggle-label">{{ 'Advanced filters'|trans }}</span>
                    {% if filters.advanced_count > 0 %}
                        <span class="badge bg-primary ms-1">{{ filters.advanced_count }}</span>
                    {% endif %}
                    <i class="bi bi-chevron-down ms-1 bo-customer-filters__toggle-caret" aria-hidden="true"></i>
                </button>
            </div>

            {#- Always collapsed by default, even with active filters: the badge above and the
                chips below already surface the active state, so the panel doesn't need to
                auto-open to communicate it - keeps behaviour identical at every width instead of
                measuring a breakpoint in JS to force it closed only below 768px. -#}
            <div id="bo-customer-advanced" class="bo-customer-filters__panel collapse"
                 data-testid="customer-advanced-panel">
                <div class="row g-2 pt-2">
                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Newsletter'|trans }}</legend>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="{{ 'Newsletter'|trans }}">
                                {% for option in filters.newsletter_options %}
                                    {% set id = 'filter-newsletter-' ~ (option.value ?: 'all') %}
                                    <input type="radio" class="btn-check" name="newsletter" id="{{ id }}"
                                           value="{{ option.value }}"
                                           {{ option.value == filters.newsletter_value ? 'checked' : '' }}>
                                    <label class="btn btn-outline-secondary btn-sm" for="{{ id }}">{{ option.label }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Guest checkout'|trans }}</legend>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="{{ 'Guest checkout'|trans }}">
                                {% for option in filters.guest_options %}
                                    {% set id = 'filter-guest-' ~ (option.value ?: 'all') %}
                                    <input type="radio" class="btn-check" name="guest" id="{{ id }}"
                                           value="{{ option.value }}"
                                           {{ option.value == filters.guest_value ? 'checked' : '' }}
                                           data-testid="customer-filter-guest-{{ option.value ?: 'all' }}">
                                    <label class="btn btn-outline-secondary btn-sm" for="{{ id }}">{{ option.label }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'VAT verification'|trans }}</legend>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="{{ 'VAT verification'|trans }}">
                                {% for option in filters.vat_verified_options %}
                                    {% set id = 'filter-vat-verified-' ~ (option.value ?: 'all') %}
                                    <input type="radio" class="btn-check" name="vat_verified" id="{{ id }}"
                                           value="{{ option.value }}"
                                           {{ option.value == filters.vat_verified_value ? 'checked' : '' }}
                                           data-testid="customer-filter-vat-verified-{{ option.value ?: 'all' }}">
                                    <label class="btn btn-outline-secondary btn-sm" for="{{ id }}">{{ option.label }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Phone'|trans }}</legend>
                            <input type="search" name="phone" value="{{ filters.phone_input }}"
                                   class="form-control form-control-sm"
                                   placeholder="{{ 'Partial number'|trans }}"
                                   data-testid="customer-filter-phone">
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Registered between'|trans }}</legend>
                            <div class="row g-2">
                                <div class="col">
                                    <input type="date" name="created_from" value="{{ filters.created_from_input }}"
                                           class="form-control form-control-sm" aria-label="{{ 'From'|trans }}"
                                           data-testid="customer-filter-created-from">
                                </div>
                                <div class="col">
                                    <input type="date" name="created_to" value="{{ filters.created_to_input }}"
                                           class="form-control form-control-sm" aria-label="{{ 'To'|trans }}"
                                           data-testid="customer-filter-created-to">
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Total spent'|trans }}</legend>
                            <div class="bo-range-slider" data-controller="bo-range-slider"
                                 data-bo-range-slider-min-value="{{ filters.total_slider.min }}"
                                 data-bo-range-slider-max-value="{{ filters.total_slider.max }}"
                                 data-bo-range-slider-step-value="{{ filters.total_slider.step }}">
                                <div class="bo-range-slider__rail">
                                    <div class="bo-range-slider__track">
                                        <div class="bo-range-slider__fill" data-bo-range-slider-target="fill"></div>
                                    </div>
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="minRange"
                                           data-action="input->bo-range-slider#onMinRange"
                                           min="{{ filters.total_slider.min }}" max="{{ filters.total_slider.max }}"
                                           step="{{ filters.total_slider.step }}"
                                           value="{{ filters.total_slider.min }}"
                                           aria-label="{{ 'Min'|trans }}">
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="maxRange"
                                           data-action="input->bo-range-slider#onMaxRange"
                                           min="{{ filters.total_slider.min }}" max="{{ filters.total_slider.max }}"
                                           step="{{ filters.total_slider.step }}"
                                           value="{{ filters.total_slider.max }}"
                                           aria-label="{{ 'Max'|trans }}">
                                </div>
                                <div class="row g-1 mt-1">
                                    <div class="col">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="min_total" value="{{ filters.min_total_input }}"
                                                   class="form-control" placeholder="{{ 'Min'|trans }}" inputmode="decimal"
                                                   aria-label="{{ 'Min'|trans }}"
                                                   data-bo-range-slider-target="minInput"
                                                   data-action="change->bo-range-slider#onMinInput"
                                                   data-testid="customer-filter-min-total">
                                            <span class="input-group-text">€</span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="max_total" value="{{ filters.max_total_input }}"
                                                   class="form-control" placeholder="{{ 'Max'|trans }}" inputmode="decimal"
                                                   aria-label="{{ 'Max'|trans }}"
                                                   data-bo-range-slider-target="maxInput"
                                                   data-action="change->bo-range-slider#onMaxInput"
                                                   data-testid="customer-filter-max-total">
                                            <span class="input-group-text">€</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Number of orders'|trans }}</legend>
                            <div class="bo-range-slider" data-controller="bo-range-slider"
                                 data-bo-range-slider-min-value="{{ filters.orders_slider.min }}"
                                 data-bo-range-slider-max-value="{{ filters.orders_slider.max }}"
                                 data-bo-range-slider-step-value="{{ filters.orders_slider.step }}">
                                <div class="bo-range-slider__rail">
                                    <div class="bo-range-slider__track">
                                        <div class="bo-range-slider__fill" data-bo-range-slider-target="fill"></div>
                                    </div>
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="minRange"
                                           data-action="input->bo-range-slider#onMinRange"
                                           min="{{ filters.orders_slider.min }}" max="{{ filters.orders_slider.max }}"
                                           step="{{ filters.orders_slider.step }}"
                                           value="{{ filters.orders_slider.min }}"
                                           aria-label="{{ 'Min'|trans }}">
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="maxRange"
                                           data-action="input->bo-range-slider#onMaxRange"
                                           min="{{ filters.orders_slider.min }}" max="{{ filters.orders_slider.max }}"
                                           step="{{ filters.orders_slider.step }}"
                                           value="{{ filters.orders_slider.max }}"
                                           aria-label="{{ 'Max'|trans }}">
                                </div>
                                <div class="row g-1 mt-1">
                                    <div class="col">
                                        <input type="number" min="0" name="min_orders" value="{{ filters.min_orders_input }}"
                                               class="form-control form-control-sm" placeholder="{{ 'Min'|trans }}"
                                               aria-label="{{ 'Min'|trans }}"
                                               data-bo-range-slider-target="minInput"
                                               data-action="change->bo-range-slider#onMinInput"
                                               data-testid="customer-filter-min-orders">
                                    </div>
                                    <div class="col">
                                        <input type="number" min="0" name="max_orders" value="{{ filters.max_orders_input }}"
                                               class="form-control form-control-sm" placeholder="{{ 'Max'|trans }}"
                                               aria-label="{{ 'Max'|trans }}"
                                               data-bo-range-slider-target="maxInput"
                                               data-action="change->bo-range-slider#onMaxInput"
                                               data-testid="customer-filter-max-orders">
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Country'|trans }}</legend>
                            <select name="country_id" class="form-select form-select-sm" data-testid="customer-filter-country">
                                <option value="">{{ 'All countries'|trans }}</option>
                                {% for option in filters.country_options %}
                                    <option value="{{ option.id }}" {{ option.id == filters.selected_country_id ? 'selected' : '' }}>
                                        {{ option.flag }} {{ option.title }}
                                    </option>
                                {% endfor %}
                            </select>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Tags'|trans }}</legend>
                            {% if filters.tag_options %}
                                {# Ticking a second tag widens the result, like the language and
                                   title filters above: a customer matches on any ticked tag. #}
                                <div class="d-flex flex-wrap gap-2">
                                    {% for option in filters.tag_options %}
                                        {% set checked = option.id in filters.selected_tag_ids %}
                                        {# A dot when the tag has a colour, nothing when it has not:
                                           a fallback icon here would put two glyph systems side by
                                           side in the same row of pills. #}
                                        <label class="bo-customer-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}">
                                            <input type="checkbox" class="visually-hidden" name="tag_ids[]"
                                                   value="{{ option.id }}" {{ checked ? 'checked' : '' }}>
                                            {% if option.color %}
                                                <span class="bo-tag-badge__swatch" style="background-color:{{ option.color }}"></span>
                                            {% endif %}{{ option.title }}
                                        </label>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted small mb-0">{{ 'No tag available'|trans }}</p>
                            {% endif %}
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Language'|trans }}</legend>
                            {% if filters.lang_options %}
                                <div class="d-flex flex-wrap gap-2">
                                    {% for option in filters.lang_options %}
                                        {% set checked = option.id in filters.selected_lang_ids %}
                                        <label class="bo-customer-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}">
                                            <input type="checkbox" class="visually-hidden" name="lang_ids[]"
                                                   value="{{ option.id }}" {{ checked ? 'checked' : '' }}>
                                            <i class="bi bi-translate me-1" aria-hidden="true"></i>{{ option.title }}
                                        </label>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted small mb-0">{{ 'No language available'|trans }}</p>
                            {% endif %}
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Customer title'|trans }}</legend>
                            {% if filters.title_options %}
                                <div class="d-flex flex-wrap gap-2">
                                    {% for option in filters.title_options %}
                                        {% set checked = option.id in filters.selected_title_ids %}
                                        <label class="bo-customer-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}">
                                            <input type="checkbox" class="visually-hidden" name="title_ids[]"
                                                   value="{{ option.id }}" {{ checked ? 'checked' : '' }}>
                                            {{ option.title }}
                                        </label>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted small mb-0">{{ 'No customer title available'|trans }}</p>
                            {% endif %}
                        </fieldset>
                    </div>
                </div>
            </div>

            <input type="hidden" name="order" value="{{ filters.sort_field }}">
            <input type="hidden" name="direction" value="{{ filters.sort_direction }}">
        </form>

        {% if filters.active_chips %}
            <div class="bo-customer-filters__active-chips d-flex align-items-center gap-2 mt-3" data-testid="customer-active-chips">
                <span class="text-muted small flex-shrink-0">{{ 'Active filters:'|trans }}</span>
                {#- Chips scroll horizontally instead of wrapping, same contained-overflow idiom
                    as .table-responsive: keeps the row height stable on narrow screens instead of
                    growing the panel with extra lines. -#}
                <div class="d-flex flex-nowrap align-items-center gap-2 overflow-x-auto" role="region" tabindex="0" aria-label="{{ 'Active filters:'|trans }}">
                    {% for chip in filters.active_chips %}
                        <a class="bo-customer-filters__chip d-inline-flex align-items-center gap-1 text-decoration-none flex-shrink-0"
                           href="{{ chip.remove_url }}"
                           data-testid="customer-active-chip-{{ chip.key }}"
                           title="{{ 'Remove this filter'|trans }}">
                            <span class="bo-customer-filters__chip-label">{{ chip.label }}:</span>
                            <strong class="bo-customer-filters__chip-value">{{ chip.value }}</strong>
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </a>
                    {% endfor %}
                </div>
                <a class="bo-customer-filters__clear-all small text-decoration-none ms-1 flex-shrink-0"
                   href="{{ filters.clear_all_url }}"
                   data-testid="customer-clear-all">
                    <i class="bi bi-eraser me-1" aria-hidden="true"></i>{{ 'Clear all'|trans }}
                </a>
            </div>
        {% endif %}

        <div class="mt-3">
            {{ safe_hook('customers.caption', { location: 'customer_list_caption' }) }}
            {# The tag column is declared visibleFrom 'xxl' and not 'xl': this table
               already fills its container at a laptop width, so below that the tags
               belong in the details panel the DataTable opens for its hidden columns
               rather than in the horizontal scroll. #}
            {{ component('BoDataTable', {
                id: 'customers',
                columns: [
                    column_html('ref_html', 'Reference'|trans, 'start', 'ref', visibleFrom: 'lg'),
                    column_html('name_html', 'Customer'|trans, 'start', 'lastname'),
                    column_html('phone_html', 'Phone'|trans, visibleFrom: 'xl'),
                    column_html('country_html', 'Country'|trans, visibleFrom: 'xl'),
                    column_html('orders_html', 'Orders'|trans, 'center', visibleFrom: 'lg'),
                    column_html('total_spent_html', 'Total spent'|trans, 'end', 'total_spent'),
                    column_html('last_order_html', 'Last order'|trans, 'start', visibleFrom: 'xl'),
                    column_html('created_html', 'Registered on'|trans, 'start', 'created_at', visibleFrom: 'lg'),
                    column_html('tags_html', 'Tags'|trans, 'start', visibleFrom: 'xxl'),
                    column_html('guest_html', 'Account'|trans, 'center'),
                    column_actions('_actions', 'Actions'|trans),
                ],
                rows: rows,
                emptyMessage: 'No customer matches the current filters.'|trans,
                extraColumnsHeaderHook: 'customers.header',
                extraColumnsHook: 'customers.row',
                headerHookContext: { location: 'customer_list_header' },
                rowHookContext: { location: 'customer_list_row' },
                rowHookArgs: { customer_id: 'id' },
                sortField: filters.sort_field,
                sortDirection: filters.sort_direction,
                sortParam: 'order',
                sortDirectionParam: 'direction',
                sortKeepParams: query_params,
                rowIdentifierKey: 'ref',
            }) }}

            {{ component('BoPagination', {
                route: 'admin.customers',
                currentPage: current_page,
                lastPage: pages,
                routeParams: query_params,
                ariaLabel: 'Customers pagination',
                testid: 'customers-pagination',
            }) }}
        </div>
    </div>

    {{ safe_hook('customer.bottom') }}

    {% include '@BackOfficeDefaultTwig/customer/_customer_create_modal.html.twig' %}
    {% include '@BackOfficeDefaultTwig/customer/_customer_delete_modal.html.twig' %}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('customers.js') }}
{% endblock %}
