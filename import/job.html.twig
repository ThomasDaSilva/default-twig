{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% set import_title = job.import ? job.import.title : 'Import'|trans %}

{% block title %}{{ 'Import'|trans }} : {{ import_title }}{% endblock %}
{% block body_testid %}import-job{% endblock %}

{% block head_extra %}
    {# The worker records the outcome on the row: the page reads it again until the import is over. #}
    {% if not job.finished %}<meta http-equiv="refresh" content="3">{% endif %}
{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('import.list') }}">{{ 'Imports'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ import_title }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {% import '@BackOfficeDefaultTwig/fragments/_job_status.html.twig' as job_status %}

    <div class="container-fluid" data-testid="import-job-page" data-import-job-status="{{ job.status }}">
        <h1 class="h3 mb-3">{{ 'Import'|trans }} : {{ import_title }}</h1>

        <div class="card">
            <div class="card-body">
                <p class="mb-2">
                    {{ job_status.badge(job.status, 'import-job-status') }}
                    <span class="text-muted ms-2">{{ job.fileName }}</span>
                </p>

                {% if job.status == 'queued' %}
                    <p class="text-muted mb-0">{{ 'The import waits for a worker. This page refreshes on its own.'|trans }}</p>
                {% elseif job.status == 'running' %}
                    <p class="text-muted mb-0">{{ 'The import is running. This page refreshes on its own.'|trans }}</p>
                {% elseif job.status == 'done' %}
                    <p class="mb-2" data-testid="import-job-rows">{{ '%count% row(s) changed.'|trans({ '%count%': job.importedRows }) }}</p>
                    {% if job.rowErrorList is not empty %}
                        <p class="mb-1">{{ 'Rows refused'|trans }}</p>
                        <ul class="small text-danger mb-0" data-testid="import-job-row-errors">
                            {% for error in job.rowErrorList %}<li class="text-break">{{ error }}</li>{% endfor %}
                        </ul>
                    {% endif %}
                {% else %}
                    <p class="text-danger mb-0 text-break" data-testid="import-job-error">{{ job.error|trans }}</p>
                {% endif %}
            </div>
        </div>

        {% if job.import %}
            <a href="{{ path('import.view', { id: job.importId }) }}" class="btn btn-outline-secondary mt-3">{{ 'Back to the import'|trans }}</a>
        {% endif %}
    </div>
{% endblock %}
