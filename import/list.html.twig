{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Import'|trans }}{% endblock %}
{% block body_testid %}import-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item"><a href="{{ path('admin.tools.index') }}">{{ 'Tools'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Import'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    <div class="container-fluid" data-testid="import-page">
        <h1 class="h3 mb-3">{{ 'Available imports'|trans }}</h1>

        {{ safe_hook('imports.top', { location: 'imports-top' }) }}

        {% if categories is empty %}
            <p class="text-muted">{{ 'No import defined.'|trans }}</p>
        {% else %}
            <div class="row g-4">
                {% for category in categories %}
                    <div class="col-md-6">
                        <div class="card">
                            <div class="card-header">{{ category.title }}</div>
                            {{ safe_hook('imports.row', { category: category.id|default(null) }) }}

                            {% set columns = [
                                column_html('title_html', 'Import'|trans),
                                column_actions(),
                            ] %}

                            {% set rows = [] %}
                            {% for import in category.imports %}
                                {% set title_html %}
                                    <strong>{{ import.title|e }}</strong>
                                    {% if import.description %}<br><small class="text-muted">{{ import.description|striptags|e }}</small>{% endif %}
                                    {% if not import.handler_available %}<br><span class="badge text-bg-warning" data-testid="import-handler-missing">{{ 'Unavailable: the module providing this import has been removed'|trans }}</span>{% endif %}
                                {% endset %}
                                {% set row_actions = [
                                    row_action('custom', 'Import'|trans, path('import.view', { id: import.id })),
                                ] %}
                                {% if import.has_template %}
                                    {% set row_actions = row_actions|merge([
                                        row_action('download', 'CSV template'|trans, path('import.template', { id: import.id })),
                                    ]) %}
                                {% endif %}
                                {% set rows = rows|merge([{
                                    'id': import.id,
                                    'title_html': title_html,
                                    '_actions': row_actions,
                                }]) %}
                            {% endfor %}

                            {{ component('BoDataTable', {
                                id: 'imports-' ~ category.id,
                                columns: columns,
                                rows: rows,
                                emptyMessage: 'No import in this category.'|trans,
                                tbodyAttributes: {
                                    'data-controller': 'bo-sortable',
                                    'data-bo-sortable-url-value': position_url,
                                    'data-bo-sortable-token-value': assignToken(),
                                    'data-bo-sortable-param-name-value': 'import_id',
                                },
                            }) }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    {{ safe_hook('imports.bottom', { location: 'imports-bottom' }) }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('imports.js', { location: 'imports-js' }) }}
{% endblock %}
