{#
    The form the merchant fills to edit the lines, the discount and the postage of an
    order. Prices and postage are untaxed, the discount is taxed (as the core stores it); the taxes are computed again by the core. Only what
    differs from the stored value is sent to the core, the rest is left alone.

    Expects: order, edit_lines, edit_discount, edit_postage, edit_state, edit_paid, token
#}
<div class="modal fade" id="order-edit-modal" tabindex="-1" aria-labelledby="order-edit-modal-title" aria-hidden="true" data-testid="order-edit-modal">
    <div class="modal-dialog modal-xl">
        <form method="post" action="{{ path('admin.order.edit', { order_id: order.id }) }}" data-testid="order-edit-form">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="order-edit-modal-title">{{ 'Edit the order'|trans }}</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="_token" value="{{ token }}">
                    <input type="hidden" name="expected_state" value="{{ edit_state }}">

                    <p class="text-muted small">{{ 'Prices and postage are entered without tax, the discount with tax. The taxes and the stock follow the changes.'|trans }}</p>
                    {% if edit_paid %}
                        <p class="text-muted small" data-testid="order-edit-paid-note">{{ 'This order is paid: its lines can be changed but not removed.'|trans }}</p>
                    {% endif %}

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label" for="order-edit-discount">{{ 'Discount (incl. tax)'|trans }}</label>
                            <input type="text" inputmode="decimal" class="form-control" id="order-edit-discount" name="discount" value="{{ edit_discount }}"
                                   data-testid="order-edit-discount">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="order-edit-postage">{{ 'Postage (excl. tax)'|trans }}</label>
                            <input type="text" inputmode="decimal" class="form-control" id="order-edit-postage" name="postage" value="{{ edit_postage }}"
                                   data-testid="order-edit-postage">
                        </div>
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">{{ 'Product'|trans }}</th>
                                    <th scope="col" class="text-center">{{ 'Quantity'|trans }}</th>
                                    <th scope="col" class="text-end">{{ 'Unit price (excl. tax)'|trans }}</th>
                                    {% if not edit_paid %}
                                        <th scope="col" class="text-center">{{ 'Remove'|trans }}</th>
                                    {% endif %}
                                </tr>
                            </thead>
                            <tbody>
                                {% for line in edit_lines %}
                                    <tr data-testid="order-edit-line-{{ line.id }}">
                                        <td>
                                            <div class="fw-semibold">{{ line.title }}</div>
                                            {% if line.ref %}<div class="text-muted small"><code>{{ line.ref }}</code></div>{% endif %}
                                        </td>
                                        {% if line.editable %}
                                            <td class="text-center" style="max-width: 8rem;">
                                                <label class="visually-hidden" for="order-edit-quantity-{{ line.id }}">{{ 'Quantity'|trans }} &mdash; {{ line.title }}</label>
                                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-center"
                                                       id="order-edit-quantity-{{ line.id }}" name="quantity[{{ line.id }}]" value="{{ line.quantity }}"
                                                       data-testid="order-edit-quantity-{{ line.id }}">
                                            </td>
                                            <td class="text-end" style="max-width: 10rem;">
                                                <label class="visually-hidden" for="order-edit-price-{{ line.id }}">{{ 'Unit price (excl. tax)'|trans }} &mdash; {{ line.title }}</label>
                                                <input type="text" inputmode="decimal" class="form-control form-control-sm text-end"
                                                       id="order-edit-price-{{ line.id }}" name="price[{{ line.id }}]" value="{{ line.price }}"
                                                       data-testid="order-edit-price-{{ line.id }}">
                                            </td>
                                            {% if not edit_paid %}
                                                <td class="text-center">
                                                    <input type="checkbox" class="form-check-input" id="order-edit-remove-{{ line.id }}" name="remove[{{ line.id }}]" value="1"
                                                           aria-label="{{ 'Remove this line'|trans }} &mdash; {{ line.title|e('html_attr') }}" data-testid="order-edit-remove-{{ line.id }}">
                                                </td>
                                            {% endif %}
                                        {% else %}
                                            <td class="text-center">{{ line.quantity }}</td>
                                            <td class="text-end">{{ line.price }}</td>
                                            {% if not edit_paid %}<td></td>{% endif %}
                                        {% endif %}
                                    </tr>
                                    {% if not line.editable %}
                                        <tr>
                                            <td colspan="{{ edit_paid ? 3 : 4 }}" class="text-muted small pt-0" data-testid="order-edit-locked-{{ line.id }}">
                                                {% if line.locked_reason == 'in_use' %}
                                                    {{ 'Shipped or returned: this line cannot be edited.'|trans }}
                                                {% else %}
                                                    {{ 'Bundle or service line: this line cannot be edited.'|trans }}
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endif %}
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                    <button type="submit" class="btn btn-primary" data-testid="order-edit-submit">
                        <i class="bi bi-pencil-square me-1" aria-hidden="true"></i>{{ 'Save the changes'|trans }}
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
