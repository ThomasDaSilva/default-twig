{#
    The payment journal of the order: what the authorization holds and what was taken,
    then every money movement, newest first.

    Expects:
      - payment_journal:          list of { id, type, type_label, state, state_label, state_badge,
                                            amount, psp_reference, actor, error_code, error_message, created_at }
      - payment_totals:           { has_authorization, authorized, captured, pending_capture, voided, refunded, remaining, capturable }
      - payment_hold_notice:      whether the authorization still holds an amount on an order not paid
      - payment_supports_capture: whether the payment module separates the authorization from the capture
      - payment_can_capture:      whether this administrator may capture now (right held, something left)
      - payment_can_settle:       whether this administrator may record by hand the outcome of a pending line
      - payment_decimals:         the decimals of the order currency
      - payment_can_refund:       whether this administrator may give money back now (right held, something collected left)
      - payment_refund_mode:      online (through the payment module) or offline (recorded as made outside the provider)
      - order_id:                 the order the journal belongs to
      - token:                    CSRF token
      - currency:                 { symbol }
#}
{% if payment_totals.has_authorization or payment_supports_capture %}
    <dl class="row mb-2 small" data-testid="order-payment-totals">
        <dt class="col-7">{{ 'Authorized'|trans }}</dt>
        <dd class="col-5 text-end mb-0" dir="ltr" data-testid="order-payment-authorized">{{ payment_totals.authorized|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
        <dt class="col-7">{{ 'Captured'|trans }}</dt>
        <dd class="col-5 text-end mb-0" dir="ltr" data-testid="order-payment-captured">{{ payment_totals.captured|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
        {% if payment_totals.pending_capture > 0 %}
            <dt class="col-7">{{ 'Awaiting the provider'|trans }}</dt>
            <dd class="col-5 text-end mb-0" dir="ltr" data-testid="order-payment-pending">{{ payment_totals.pending_capture|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
        {% endif %}
        {% if payment_totals.voided > 0 %}
            <dt class="col-7">{{ 'Released'|trans }}</dt>
            <dd class="col-5 text-end mb-0" dir="ltr" data-testid="order-payment-voided">{{ payment_totals.voided|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
        {% endif %}
        <dt class="col-7 fw-semibold">{{ 'Remaining to capture'|trans }}</dt>
        <dd class="col-5 text-end mb-0 fw-semibold" dir="ltr" data-testid="order-payment-remaining">{{ payment_totals.remaining|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
    </dl>
    {% if payment_hold_notice %}
        <p class="small text-warning-emphasis mb-2" data-testid="order-payment-hold-notice">
            <i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>{{ 'The payment is authorized, not taken: marking the order paid by hand takes nothing from the buyer. Capture it to take the money.'|trans }}
        </p>
    {% endif %}
    {% if payment_can_capture %}
        <button type="button" class="btn btn-sm btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#order-payment-capture-modal" data-testid="order-payment-capture-btn">
            <i class="bi bi-cash-coin me-1" aria-hidden="true"></i>{{ 'Capture payment'|trans }}
        </button>
    {% endif %}
{% endif %}

{% if payment_totals.captured > 0 %}
    <dl class="row mb-2 small" data-testid="order-payment-refund-totals">
        <dt class="col-7">{{ 'Refunded'|trans }}</dt>
        <dd class="col-5 text-end mb-0" dir="ltr" data-testid="order-payment-refunded">{{ payment_totals.refunded|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
        <dt class="col-7">{{ 'Left to refund'|trans }}</dt>
        <dd class="col-5 text-end mb-0" dir="ltr" data-testid="order-payment-refundable">{{ payment_totals.refundable|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</dd>
    </dl>
{% endif %}
{% if payment_can_refund %}
    <button type="button" class="btn btn-sm btn-outline-secondary mb-3" data-bs-toggle="modal" data-bs-target="#order-payment-refund-modal" data-testid="order-payment-refund-btn" data-refund-mode="{{ payment_refund_mode }}">
        <i class="bi bi-arrow-counterclockwise me-1" aria-hidden="true"></i>{{ payment_refund_mode == 'online' ? 'Refund'|trans : 'Record a refund'|trans }}
    </button>
{% endif %}

<h3 class="h6 mt-2 mb-2">{{ 'Payment journal'|trans }}</h3>
{% if payment_journal is empty %}
    <p class="mb-1 text-muted" data-testid="order-payment-journal-empty">{{ 'No payment movement recorded for this order'|trans }}</p>
{% else %}
    {# A list rather than a table: the card sits in the narrow column of the sheet, and six
       columns there only fit by scrolling sideways. Each movement reads on its own lines. #}
    <ul class="list-unstyled mb-1 small" data-testid="order-payment-journal">
        {% for line in payment_journal %}
            <li class="border-top py-2" data-testid="order-payment-line" data-payment-type="{{ line.type }}" data-payment-state="{{ line.state }}">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-1">
                    <span>
                        <strong>{{ line.type_label }}</strong>
                        <span class="badge {{ line.state_badge }} ms-1">{{ line.state_label }}</span>
                    </span>
                    <span class="text-nowrap fw-semibold" dir="ltr">{{ line.amount|number_format(payment_decimals, '.', ' ') }} {{ currency.symbol }}</span>
                </div>
                <div class="text-muted text-break">
                    {{ line.created_at ? line.created_at|date('d/m/Y H:i') : '-' }}
                    · {{ line.actor }}
                    {% if line.psp_reference %}· <code>{{ line.psp_reference }}</code>{% endif %}
                </div>
                {% if line.error_code or line.error_message %}
                    {# The provider's words, escaped: they come from a third party. #}
                    <div class="text-danger text-break" data-testid="order-payment-line-error">
                        {% if line.error_code %}<code>{{ line.error_code }}</code>{% endif %}
                        {{ line.error_message }}
                    </div>
                {% endif %}
                {% if line.note %}
                    <div class="text-muted text-break" data-testid="order-payment-line-note">{{ line.note }}</div>
                {% endif %}
                {% if payment_can_settle and line.state == 'pending' %}
                    {# The provider never confirmed: the merchant reads the outcome in the
                       provider's back office and records it here. #}
                    <form method="post" action="{{ path('admin.order.update.paymentSettle', { order_id: order_id, transaction_id: line.id }) }}" class="mt-2" data-testid="order-payment-settle-form">
                        <input type="hidden" name="_token" value="{{ token }}">
                        <label for="order-payment-settle-reference-{{ line.id }}" class="form-label mb-1">{{ 'Outcome read at the provider'|trans }}</label>
                        <input type="text" id="order-payment-settle-reference-{{ line.id }}" name="psp_reference" maxlength="100" class="form-control form-control-sm mb-1" placeholder="{{ 'Provider reference (optional)'|trans }}">
                        <div class="d-flex flex-wrap gap-1">
                            <button type="submit" name="outcome" value="succeeded" class="btn btn-sm btn-outline-success" data-testid="order-payment-settle-succeeded">{{ 'Succeeded'|trans }}</button>
                            <button type="submit" name="outcome" value="failed" class="btn btn-sm btn-outline-danger" data-testid="order-payment-settle-failed">{{ 'Failed'|trans }}</button>
                        </div>
                    </form>
                {% endif %}
            </li>
        {% endfor %}
    </ul>
{% endif %}
