{% extends '@BackOfficeDefaultTwig/base.html.twig' %}

{% block title %}{{ 'Orders'|trans }}{% endblock %}
{% block body_testid %}order-list{% endblock %}

{% block breadcrumb %}
    <nav aria-label="breadcrumb" class="mb-1">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a href="{{ path('admin.home') }}">{{ 'Home'|trans }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">{{ 'Orders'|trans }}</li>
        </ol>
    </nav>
{% endblock %}

{% block content %}
    {{ safe_hook('orders.top') }}

    <div class="container-fluid" data-testid="orders-page" data-controller="bo-bulk-select" data-bo-bulk-select-param-value="order_ids[]">
        {% embed '@BackOfficeDefaultTwig/_page_header.html.twig' with { title: 'Orders management'|trans } %}
            {% block actions %}
                <div class="d-flex flex-wrap align-items-center gap-2" data-testid="order-quick-filters">
                    {% for chip in filters.quick_chips %}
                        <a class="btn btn-sm {{ chip.active ? 'btn-primary' : 'btn-outline-secondary' }}"
                           href="{{ chip.url }}"
                           data-testid="order-quick-filter-{{ chip.code }}">
                            <i class="bi {{ chip.icon }} me-1" aria-hidden="true"></i>{{ chip.label }}
                        </a>
                    {% endfor %}
                </div>
            {% endblock %}
        {% endembed %}

        <form method="get" action="{{ path('admin.order.list') }}" class="bo-order-filters" data-testid="order-search-form">
            <div class="row g-2 align-items-end">
                <div class="col-md-9">
                    <label class="form-label" for="order-search-q">{{ 'Search'|trans }}</label>
                    <input type="search" id="order-search-q" name="q" value="{{ filters.search_input }}"
                           class="form-control"
                           placeholder="{{ 'Reference, customer name or email'|trans }}"
                           data-testid="order-search-input">
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1" data-testid="order-search-submit">
                        <i class="bi bi-funnel me-1" aria-hidden="true"></i>{{ 'Apply'|trans }}
                    </button>
                    <a href="{{ filters.clear_all_url }}" class="btn btn-outline-secondary" data-testid="order-reset">{{ 'Reset'|trans }}</a>
                </div>
            </div>

            <div class="mt-3">
                <button type="button" class="btn btn-link p-0 bo-order-filters__toggle" data-bs-toggle="collapse"
                        data-bs-target="#bo-order-advanced" aria-controls="bo-order-advanced"
                        aria-expanded="false"
                        data-testid="order-advanced-toggle">
                    <i class="bi bi-sliders me-1" aria-hidden="true"></i>
                    <span class="bo-order-filters__toggle-label">{{ 'Advanced filters'|trans }}</span>
                    {% if filters.advanced_count > 0 %}
                        <span class="badge bg-primary ms-1">{{ filters.advanced_count }}</span>
                    {% endif %}
                    <i class="bi bi-chevron-down ms-1 bo-order-filters__toggle-caret" aria-hidden="true"></i>
                </button>
            </div>

            {#- Always collapsed by default, even with active filters: the badge above and the
                chips below already surface the active state, so the panel doesn't need to
                auto-open to communicate it - keeps behaviour identical at every width instead of
                measuring a breakpoint in JS to force it closed only below 768px. -#}
            <div id="bo-order-advanced" class="bo-order-filters__panel collapse"
                 data-testid="order-advanced-panel">
                <div class="row g-2 pt-2">
                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Status'|trans }}</legend>
                            <div class="d-flex flex-wrap gap-2">
                                {% for option in filters.status_options %}
                                    {% set checked = option.id in filters.selected_status_ids %}
                                    <label class="bo-order-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}"
                                           style="--pill-color: {{ option.color }};">
                                        <input type="checkbox" class="visually-hidden" name="status_ids[]"
                                               value="{{ option.id }}" {{ checked ? 'checked' : '' }}>
                                        <span class="bo-order-filters__pill-dot" aria-hidden="true"></span>
                                        {{ option.title }}
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Created between'|trans }}</legend>
                            <div class="row g-2">
                                <div class="col">
                                    <input type="date" name="created_from" value="{{ filters.created_from_input }}"
                                           class="form-control form-control-sm" aria-label="{{ 'From'|trans }}"
                                           data-testid="order-filter-created-from">
                                </div>
                                <div class="col">
                                    <input type="date" name="created_to" value="{{ filters.created_to_input }}"
                                           class="form-control form-control-sm" aria-label="{{ 'To'|trans }}"
                                           data-testid="order-filter-created-to">
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label d-inline-flex align-items-center gap-1">
                                <span>{{ 'Total amount (TTC)'|trans }}</span>
                                <i class="bi bi-info-circle text-muted small"
                                   data-bs-toggle="tooltip"
                                   title="{{ 'Includes postage and discount'|trans }}"></i>
                            </legend>
                            <div class="bo-range-slider" data-controller="bo-range-slider"
                                 data-bo-range-slider-min-value="{{ filters.amount_slider.min }}"
                                 data-bo-range-slider-max-value="{{ filters.amount_slider.max }}"
                                 data-bo-range-slider-step-value="{{ filters.amount_slider.step }}">
                                <div class="bo-range-slider__rail">
                                    <div class="bo-range-slider__track">
                                        <div class="bo-range-slider__fill" data-bo-range-slider-target="fill"></div>
                                    </div>
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="minRange"
                                           data-action="input->bo-range-slider#onMinRange"
                                           min="{{ filters.amount_slider.min }}" max="{{ filters.amount_slider.max }}"
                                           step="{{ filters.amount_slider.step }}"
                                           value="{{ filters.amount_slider.min }}"
                                           aria-label="{{ 'Min'|trans }}">
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="maxRange"
                                           data-action="input->bo-range-slider#onMaxRange"
                                           min="{{ filters.amount_slider.min }}" max="{{ filters.amount_slider.max }}"
                                           step="{{ filters.amount_slider.step }}"
                                           value="{{ filters.amount_slider.max }}"
                                           aria-label="{{ 'Max'|trans }}">
                                </div>
                                <div class="row g-1 mt-1">
                                    <div class="col">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="min_amount" value="{{ filters.min_amount_input }}"
                                                   class="form-control" placeholder="{{ 'Min'|trans }}" inputmode="decimal"
                                                   aria-label="{{ 'Min'|trans }}"
                                                   data-bo-range-slider-target="minInput"
                                                   data-action="change->bo-range-slider#onMinInput"
                                                   data-testid="order-filter-min-amount">
                                            <span class="input-group-text">€</span>
                                        </div>
                                    </div>
                                    <div class="col">
                                        <div class="input-group input-group-sm">
                                            <input type="text" name="max_amount" value="{{ filters.max_amount_input }}"
                                                   class="form-control" placeholder="{{ 'Max'|trans }}" inputmode="decimal"
                                                   aria-label="{{ 'Max'|trans }}"
                                                   data-bo-range-slider-target="maxInput"
                                                   data-action="change->bo-range-slider#onMaxInput"
                                                   data-testid="order-filter-max-amount">
                                            <span class="input-group-text">€</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Payment method'|trans }}</legend>
                            {% if filters.payment_module_options %}
                                <div class="d-flex flex-wrap gap-2">
                                    {% for option in filters.payment_module_options %}
                                        {% set checked = option.id in filters.selected_payment_module_ids %}
                                        <label class="bo-order-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}">
                                            <input type="checkbox" class="visually-hidden" name="payment_module_ids[]"
                                                   value="{{ option.id }}" {{ checked ? 'checked' : '' }}>
                                            <i class="bi bi-credit-card me-1" aria-hidden="true"></i>{{ option.title }}
                                        </label>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted small mb-0">{{ 'No active payment module'|trans }}</p>
                            {% endif %}
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Delivery method'|trans }}</legend>
                            {% if filters.delivery_module_options %}
                                <div class="d-flex flex-wrap gap-2">
                                    {% for option in filters.delivery_module_options %}
                                        {% set checked = option.id in filters.selected_delivery_module_ids %}
                                        <label class="bo-order-filters__pill" data-checked="{{ checked ? 'true' : 'false' }}">
                                            <input type="checkbox" class="visually-hidden" name="delivery_module_ids[]"
                                                   value="{{ option.id }}" {{ checked ? 'checked' : '' }}>
                                            <i class="bi bi-truck me-1" aria-hidden="true"></i>{{ option.title }}
                                        </label>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <p class="text-muted small mb-0">{{ 'No active delivery module'|trans }}</p>
                            {% endif %}
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Delivery country'|trans }}</legend>
                            <select name="country_id" class="form-select form-select-sm" data-testid="order-filter-country">
                                <option value="">{{ 'All countries'|trans }}</option>
                                {% for option in filters.country_options %}
                                    <option value="{{ option.id }}" {{ option.id == filters.selected_country_id ? 'selected' : '' }}>
                                        {{ option.flag }} {{ option.title }}
                                    </option>
                                {% endfor %}
                            </select>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Number of items'|trans }}</legend>
                            <div class="bo-range-slider" data-controller="bo-range-slider"
                                 data-bo-range-slider-min-value="{{ filters.items_slider.min }}"
                                 data-bo-range-slider-max-value="{{ filters.items_slider.max }}"
                                 data-bo-range-slider-step-value="{{ filters.items_slider.step }}">
                                <div class="bo-range-slider__rail">
                                    <div class="bo-range-slider__track">
                                        <div class="bo-range-slider__fill" data-bo-range-slider-target="fill"></div>
                                    </div>
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="minRange"
                                           data-action="input->bo-range-slider#onMinRange"
                                           min="{{ filters.items_slider.min }}" max="{{ filters.items_slider.max }}"
                                           step="{{ filters.items_slider.step }}"
                                           value="{{ filters.items_slider.min }}"
                                           aria-label="{{ 'Min'|trans }}">
                                    <input type="range" class="bo-range-slider__handle"
                                           data-bo-range-slider-target="maxRange"
                                           data-action="input->bo-range-slider#onMaxRange"
                                           min="{{ filters.items_slider.min }}" max="{{ filters.items_slider.max }}"
                                           step="{{ filters.items_slider.step }}"
                                           value="{{ filters.items_slider.max }}"
                                           aria-label="{{ 'Max'|trans }}">
                                </div>
                                <div class="row g-1 mt-1">
                                    <div class="col">
                                        <input type="number" min="0" name="min_items" value="{{ filters.min_items_input }}"
                                               class="form-control form-control-sm" placeholder="{{ 'Min'|trans }}"
                                               aria-label="{{ 'Min'|trans }}"
                                               data-bo-range-slider-target="minInput"
                                               data-action="change->bo-range-slider#onMinInput"
                                               data-testid="order-filter-min-items">
                                    </div>
                                    <div class="col">
                                        <input type="number" min="0" name="max_items" value="{{ filters.max_items_input }}"
                                               class="form-control form-control-sm" placeholder="{{ 'Max'|trans }}"
                                               aria-label="{{ 'Max'|trans }}"
                                               data-bo-range-slider-target="maxInput"
                                               data-action="change->bo-range-slider#onMaxInput"
                                               data-testid="order-filter-max-items">
                                    </div>
                                </div>
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Coupon'|trans }}</legend>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="{{ 'Coupon'|trans }}">
                                {% for option in filters.tristate_options %}
                                    {% set id = 'filter-coupon-' ~ (option.value ?: 'all') %}
                                    <input type="radio" class="btn-check" name="coupon" id="{{ id }}"
                                           value="{{ option.value }}"
                                           {{ option.value == filters.coupon_value ? 'checked' : '' }}>
                                    <label class="btn btn-outline-secondary btn-sm" for="{{ id }}">{{ option.label }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>

                    <div class="col-md-6 col-lg-4">
                        <fieldset>
                            <legend class="form-label">{{ 'Tracking'|trans }}</legend>
                            <div class="btn-group btn-group-sm w-100" role="group" aria-label="{{ 'Tracking'|trans }}">
                                {% for option in filters.tristate_options %}
                                    {% set id = 'filter-tracking-' ~ (option.value ?: 'all') %}
                                    <input type="radio" class="btn-check" name="tracking" id="{{ id }}"
                                           value="{{ option.value }}"
                                           {{ option.value == filters.tracking_value ? 'checked' : '' }}>
                                    <label class="btn btn-outline-secondary btn-sm" for="{{ id }}">{{ option.label }}</label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    </div>
                </div>
            </div>

            <input type="hidden" name="order" value="{{ filters.sort_field }}">
            <input type="hidden" name="direction" value="{{ filters.sort_direction }}">
        </form>

        {% if filters.active_chips %}
            <div class="bo-order-filters__active-chips d-flex align-items-center gap-2 mt-3" data-testid="order-active-chips">
                <span class="text-muted small flex-shrink-0">{{ 'Active filters:'|trans }}</span>
                {#- Chips scroll horizontally instead of wrapping, same contained-overflow idiom
                    as .table-responsive: keeps the row height stable on narrow screens instead of
                    growing the panel with extra lines. -#}
                <div class="d-flex flex-nowrap align-items-center gap-2 overflow-x-auto" role="region" tabindex="0" aria-label="{{ 'Active filters:'|trans }}">
                    {% for chip in filters.active_chips %}
                        <a class="bo-order-filters__chip d-inline-flex align-items-center gap-1 text-decoration-none flex-shrink-0"
                           href="{{ chip.remove_url }}"
                           data-testid="order-active-chip-{{ chip.key }}"
                           title="{{ 'Remove this filter'|trans }}">
                            <span class="bo-order-filters__chip-label">{{ chip.label }}:</span>
                            <strong class="bo-order-filters__chip-value">{{ chip.value }}</strong>
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </a>
                    {% endfor %}
                </div>
                <a class="bo-order-filters__clear-all small text-decoration-none ms-1 flex-shrink-0"
                   href="{{ filters.clear_all_url }}"
                   data-testid="order-clear-all">
                    <i class="bi bi-eraser me-1" aria-hidden="true"></i>{{ 'Clear all'|trans }}
                </a>
            </div>
        {% endif %}

        <div class="mt-3">
            {% if is_granted('UPDATE', 'admin.order') %}
                <div class="bo-bulk-toolbar card border-0 shadow-sm mb-3" data-bo-bulk-select-target="toolbar" hidden data-testid="order-bulk-toolbar">
                    <form method="post" action="{{ bulk_status_url }}" class="card-body d-flex flex-wrap align-items-center gap-2 py-2"
                          data-bo-bulk-select-target="form" data-testid="order-bulk-status-form">
                        <input type="hidden" name="_token" value="{{ assignToken() }}">
                        <span class="badge text-bg-primary" data-testid="order-bulk-count">
                            <span data-bo-bulk-select-target="count">0</span>
                            {{ 'selected'|trans }}
                        </span>
                        <label class="visually-hidden" for="order-bulk-status">{{ 'Move the selected orders to'|trans }}</label>
                        <select id="order-bulk-status" name="status_id" class="form-select form-select-sm w-auto" required data-testid="order-bulk-status-select">
                            <option value="">{{ 'Move the selected orders to'|trans }}</option>
                            {% for status in bulk_statuses %}
                                <option value="{{ status.id }}">{{ status.title }}</option>
                            {% endfor %}
                        </select>
                        <button type="submit" class="btn btn-sm btn-primary" data-testid="order-bulk-status-submit">{{ 'Apply'|trans }}</button>
                        <span class="small text-muted">{{ 'Orders whose current status does not allow the transition are skipped and named.'|trans }}</span>
                        <button type="button" class="btn btn-sm btn-link" data-action="bo-bulk-select#clear" data-testid="order-bulk-clear">{{ 'Clear selection'|trans }}</button>
                    </form>
                </div>
            {% endif %}

            {% set order_columns = [
                column_html('ref_html', 'Reference'|trans, 'start', 'ref'),
                column_html('customer_html', 'Customer'|trans, visibleFrom: 'lg'),
                column_html('items_html', 'Items'|trans, 'center', visibleFrom: 'lg'),
                column_badge('status_code', 'Status'|trans, {}, 'start', 'status', 'status_color'),
                column_html('payment_html', 'Payment'|trans, visibleFrom: 'xl'),
                column_html('delivery_html', 'Delivery'|trans, visibleFrom: 'xl'),
                column_text('amount', 'Total'|trans, 'end', 'amount'),
                column_html('date_html', 'Date'|trans, 'start', 'created_at', visibleFrom: 'lg'),
                column_actions('_actions', 'Actions'|trans),
            ] %}
            {% if is_granted('UPDATE', 'admin.order') %}
                {% set order_columns = [column_select('_select', 'Select this order'|trans, 'id', 'ref')]|merge(order_columns) %}
            {% endif %}

            {{ component('BoDataTable', {
                id: 'orders',
                columns: order_columns,
                rows: rows,
                emptyMessage: 'No order matches the current filters.'|trans,
                sortField: filters.sort_field,
                sortDirection: filters.sort_direction,
                sortParam: 'order',
                sortDirectionParam: 'direction',
                sortKeepParams: query_params,
                rowIdentifierKey: 'ref',
            }) }}

            {{ component('BoPagination', {
                route: 'admin.order.list',
                currentPage: current_page,
                lastPage: pages,
                routeParams: query_params,
                ariaLabel: 'Order pagination',
                testid: 'order-pagination',
            }) }}
        </div>
    </div>

    <div class="modal fade" id="order-cancel-modal" tabindex="-1" aria-labelledby="order-cancel-modal-title" aria-hidden="true"
         data-controller="bo-order-cancel-modal" data-testid="order-cancel-modal">
        <div class="modal-dialog">
            <div class="modal-content">
                <form method="post"
                      action="{{ path('admin.order.list.cancel', { order_id: 0 }) }}?_token={{ assignToken() }}"
                      data-bo-order-cancel-modal-target="form"
                      data-testid="order-cancel-form">
                    <div class="modal-header">
                        <h2 class="modal-title h5" id="order-cancel-modal-title">{{ 'Cancel order'|trans }}</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="order_id" value="" data-bo-order-cancel-modal-target="orderIdInput">
                        <p class="mb-0">
                            {{ 'Do you really want to cancel this order?'|trans }}
                            <strong>#<span data-bo-order-cancel-modal-target="orderRefLabel"></span></strong>
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'Close'|trans }}</button>
                        <button type="submit" class="btn btn-danger" data-testid="order-cancel-submit">
                            <i class="bi bi-x-circle" aria-hidden="true"></i> {{ 'Cancel this order'|trans }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    {{ safe_hook('orders.bottom') }}
{% endblock %}

{% block scripts_extra %}
    {{ safe_hook('orders.js', { location: 'orders-js' }) }}
{% endblock %}
